# ==============================================================================
# Cyber Scotland Connect (CSC) - Environment Configuration Template
# ==============================================================================
#
# IMPORTANT SECURITY NOTICE:
# This project is hosted on GitHub Pages (static site hosting).
# All environment variables embedded in client bundles are PUBLICLY ACCESSIBLE
# in the browser. NEVER put secrets, private keys, or backend tokens here.
#
# Usage:
# 1. Copy this file to `.env`:
#    cp .env.example .env
# 2. Update the values below for your local development environment.
# ==============================================================================

# Site Configuration
PUBLIC_SITE_URL=https://cyberscotlandconnect.com
PUBLIC_SITE_NAME="Cyber Scotland Connect"
PUBLIC_SITE_DESCRIPTION="Scotland's community for cyber security professionals, students, and enthusiasts."

# Analytics / Telemetry (Public identifiers only, if used)
# PUBLIC_ANALYTICS_ID=

# Contact / Feedback Form endpoint (if using a 3rd-party serverless service like Formspree or Netlify Forms)
# PUBLIC_CONTACT_FORM_ENDPOINT=
