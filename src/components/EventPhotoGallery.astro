---
export interface EventPhoto {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  photos?: EventPhoto[];
  albumUrl?: string;
  eventTitle?: string;
}

const { photos = [], albumUrl, eventTitle = 'Event' } = Astro.props;
const hasPhotos = photos && photos.length > 0;
const hasAlbum = Boolean(albumUrl);
---

{
  (hasPhotos || hasAlbum) && (
    <section class="mb-12" aria-labelledby="gallery-heading">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
        <div>
          <h2
            id="gallery-heading"
            class="text-2xl font-heading font-bold text-slate-900 dark:text-white uppercase tracking-wide flex items-center gap-2.5"
          >
            <span class="text-xl" aria-hidden="true">
              📸
            </span>
            <span>Event Photos & Memories</span>
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-[#bdaccf] mt-1">
            Moments captured from this gathering.
          </p>
        </div>

        {hasAlbum && (
          <a
            href={albumUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white dark:bg-[#2a2948] text-[#895294] dark:text-[#6fb7e6] hover:bg-[#895294] hover:text-white dark:hover:bg-[#56548c] dark:hover:text-white border border-slate-200 dark:border-[#3e3c66] transition-all shadow-sm"
          >
            <span>View Shared Album</span>
            <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>

      {hasPhotos && (
        <div
          class={`grid gap-4 ${
            photos.length === 1
              ? 'grid-cols-1 max-w-xl mx-auto'
              : photos.length === 2
                ? 'grid-cols-1 sm:grid-cols-2'
                : 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3'
          }`}
        >
          {photos.map((photo) => (
            <figure class="group relative overflow-hidden rounded-xl bg-slate-100 dark:bg-[#1b1a30] border border-slate-200 dark:border-[#3e3c66] shadow-sm transition-all hover:border-[#895294] dark:hover:border-[#6fb7e6]">
              <div class="aspect-4/3 overflow-hidden bg-slate-200 dark:bg-[#21203a]">
                <img
                  src={photo.src}
                  alt={photo.alt || `Photo from ${eventTitle}`}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </div>
              {photo.caption && (
                <figcaption class="p-3 text-xs text-slate-600 dark:text-[#bdaccf] bg-white dark:bg-[#2a2948] border-t border-slate-100 dark:border-[#3e3c66] leading-relaxed">
                  {photo.caption}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      )}

      {hasAlbum && !hasPhotos && (
        <div class="p-6 rounded-xl bg-white dark:bg-[#2a2948] border border-slate-200 dark:border-[#3e3c66] flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-purple-50 dark:bg-[#382b5c] text-[#895294] dark:text-[#6fb7e6] flex items-center justify-center text-lg">
              🖼️
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-900 dark:text-white">
                Community Photo Album
              </h3>
              <p class="text-xs text-slate-600 dark:text-[#bdaccf]">
                Full resolution photos from this gathering are hosted on our
                shared community album.
              </p>
            </div>
          </div>
          <a
            href={albumUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 rounded-lg bg-[#895294] hover:bg-[#9d5fa8] text-white text-xs font-bold transition-all shrink-0"
          >
            Open Album ↗
          </a>
        </div>
      )}
    </section>
  )
}
