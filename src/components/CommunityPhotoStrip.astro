---
export interface PhotoItem {
  src: string;
  alt: string;
  caption?: string;
  eventSlug?: string;
}

interface Props {
  photos?: PhotoItem[];
  albumUrl?: string;
  title?: string;
  subtitle?: string;
}

const {
  photos = [],
  albumUrl,
  title = 'Community in Action',
  subtitle = 'Snapshots from Scottish meetups, keynote gatherings, and technical workshops across Edinburgh, Glasgow, and Dundee.',
} = Astro.props;

const hasPhotos = photos && photos.length > 0;
const hasAlbum = Boolean(albumUrl);
---

{
  (hasPhotos || hasAlbum) && (
    <section
      class="py-12 border-t border-slate-200 dark:border-[#3e3c66] transition-colors"
      aria-labelledby="community-photos-heading"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-[#56548c] dark:text-[#6fb7e6] block mb-1">
              Historic Archives
            </span>
            <h2
              id="community-photos-heading"
              class="text-2xl sm:text-3xl font-heading font-bold text-slate-900 dark:text-white uppercase tracking-tight"
            >
              {title}
            </h2>
            <p class="text-slate-600 dark:text-[#bdaccf] text-sm mt-1 max-w-2xl">
              {subtitle}
            </p>
          </div>

          {hasAlbum && (
            <a
              href={albumUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-bold text-white bg-[#895294] hover:bg-[#9d5fa8] shadow-md shadow-[#895294]/20 hover:shadow-lg transition-all"
            >
              <span>Browse Full Photo Album</span>
              <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>

        {hasPhotos && (
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {photos.slice(0, 4).map((photo) => (
              <figure class="group relative overflow-hidden rounded-xl bg-slate-100 dark:bg-[#1b1a30] border border-slate-200 dark:border-[#3e3c66] shadow-sm hover:border-[#895294] dark:hover:border-[#6fb7e6] transition-all">
                <div class="aspect-4/3 overflow-hidden bg-slate-200 dark:bg-[#21203a]">
                  <img
                    src={photo.src}
                    alt={photo.alt}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
                {photo.caption && (
                  <figcaption class="p-2.5 text-[11px] text-slate-600 dark:text-[#bdaccf] bg-white dark:bg-[#2a2948] border-t border-slate-100 dark:border-[#3e3c66] truncate">
                    {photo.caption}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        )}
      </div>
    </section>
  )
}
