---
import type { CollectionEntry } from 'astro:content';

interface Props {
  leader: CollectionEntry<'leaders'>;
}

const { leader } = Astro.props;
const { data, body } = leader;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const avatarUrl = data.avatar 
  ? (data.avatar.startsWith('http') ? data.avatar : `${base}${data.avatar.startsWith('/') ? '' : '/'}${data.avatar}`)
  : null;
---

<div class="bg-white dark:bg-[#2a2948] rounded-2xl border border-slate-200 dark:border-[#3e3c66] p-6 sm:p-7 hover:border-[#895294] shadow-sm hover:shadow-xl transition-all duration-200 flex flex-col justify-between">
  <div>
    <div class="flex items-start gap-4 mb-4">
      <div class="w-16 h-16 rounded-2xl bg-[#895294]/10 dark:bg-[#21203a] border border-slate-200 dark:border-[#3e3c66] p-2 flex items-center justify-center shrink-0 shadow-inner group">
        {avatarUrl ? (
          <img src={avatarUrl} alt={data.name} class="w-full h-full object-contain" width="48" height="48" />
        ) : (
          <span class="text-[#895294] dark:text-[#6fb7e6] text-xl font-bold font-heading">{data.name.split(' ').map(n => n[0]).join('')}</span>
        )}
      </div>
      <div>
        <div class="flex flex-wrap items-center gap-2 mb-0.5">
          <h3 class="text-xl font-heading font-bold text-slate-900 dark:text-white">{data.name}</h3>
          {data.status === 'alumni' && (
            <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-[#bdaccf] border border-slate-200 dark:border-slate-700">
              Community Alumni
            </span>
          )}
        </div>
        <p class="text-sm font-semibold text-[#895294] dark:text-[#6fb7e6]">{data.role}</p>
        <p class="text-xs text-slate-500 dark:text-[#bdaccf] flex items-center gap-1 mt-1">
          <svg class="w-3.5 h-3.5 text-[#895294]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          </svg>
          <span>{data.chapter}</span>
        </p>
      </div>
    </div>

    <p class="text-sm text-slate-600 dark:text-[#bdaccf] leading-relaxed mb-4">
      {data.bio}
    </p>

    {body && body.trim().length > 0 && (
      <div class="text-xs text-slate-600 dark:text-slate-300 bg-slate-50 dark:bg-[#21203a] p-3.5 rounded-xl border border-slate-200 dark:border-[#3e3c66]/60 leading-relaxed mb-4">
        {body}
      </div>
    )}
  </div>

  <div class="pt-4 border-t border-slate-100 dark:border-[#3e3c66] flex items-center gap-4 text-xs font-semibold">
    {data.linkedin && (
      <a
        href={data.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="text-[#895294] dark:text-[#6fb7e6] hover:underline flex items-center gap-1 transition-colors"
      >
        <span>LinkedIn</span> ↗
      </a>
    )}
    {data.github && (
      <a
        href={data.github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-slate-600 dark:text-[#bdaccf] hover:text-slate-900 dark:hover:text-white flex items-center gap-1 transition-colors"
      >
        <span>GitHub</span> ↗
      </a>
    )}
    {data.website && (
      <a
        href={data.website}
        target="_blank"
        rel="noopener noreferrer"
        class="text-slate-600 dark:text-[#bdaccf] hover:text-slate-900 dark:hover:text-white flex items-center gap-1 transition-colors"
      >
        <span>Website</span> ↗
      </a>
    )}
  </div>
</div>
