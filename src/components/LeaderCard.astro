---
import type { CollectionEntry } from 'astro:content';

interface Props {
  leader: CollectionEntry<'leaders'>;
}

const { leader } = Astro.props;
const { data, body } = leader;
---

<div class="bg-white dark:bg-[#2a2948] rounded-xl border border-slate-200 dark:border-[#3e3c66] p-6 hover:border-[#56548c] shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
  <div>
    <div class="flex items-start gap-4 mb-4">
      <div class="w-16 h-16 rounded-xl bg-gradient-to-br from-[#895294] to-[#56548c] flex items-center justify-center text-white text-xl font-bold font-heading shrink-0 shadow-md">
        {data.avatar ? (
          <img src={data.avatar} alt={data.name} class="w-full h-full object-cover rounded-xl" />
        ) : (
          <span>{data.name.split(' ').map(n => n[0]).join('')}</span>
        )}
      </div>
      <div>
        <h3 class="text-xl font-heading font-bold text-slate-900 dark:text-white mb-0.5">{data.name}</h3>
        <p class="text-sm font-semibold text-[#56548c] dark:text-[#6fb7e6]">{data.role}</p>
        <p class="text-xs text-slate-500 dark:text-[#bdaccf] flex items-center gap-1 mt-1">
          <svg class="w-3.5 h-3.5 text-[#895294]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          </svg>
          <span>{data.chapter}</span>
        </p>
      </div>
    </div>

    <p class="text-sm text-slate-600 dark:text-[#bdaccf] leading-relaxed mb-4">
      {data.bio}
    </p>

    {body && body.trim().length > 0 && (
      <div class="text-xs text-slate-600 dark:text-slate-300 bg-slate-50 dark:bg-[#21203a] p-3 rounded-lg border border-slate-200 dark:border-[#3e3c66]/60 leading-relaxed mb-4">
        {body}
      </div>
    )}
  </div>

  <div class="pt-4 border-t border-slate-100 dark:border-[#3e3c66] flex items-center gap-3 text-xs">
    {data.linkedin && (
      <a
        href={data.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="text-[#56548c] dark:text-[#6fb7e6] hover:underline flex items-center gap-1 font-semibold transition-colors"
      >
        <span>LinkedIn</span> ↗
      </a>
    )}
    {data.github && (
      <a
        href={data.github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-slate-600 dark:text-[#bdaccf] hover:text-slate-900 dark:hover:text-white flex items-center gap-1 font-medium transition-colors"
      >
        <span>GitHub</span> ↗
      </a>
    )}
    {data.website && (
      <a
        href={data.website}
        target="_blank"
        rel="noopener noreferrer"
        class="text-slate-600 dark:text-[#bdaccf] hover:text-slate-900 dark:hover:text-white flex items-center gap-1 font-medium transition-colors"
      >
        <span>Website</span> ↗
      </a>
    )}
  </div>
</div>
