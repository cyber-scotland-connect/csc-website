---
import type { CollectionEntry } from 'astro:content';

interface Props {
  partner: CollectionEntry<'partners'>;
}

const { partner } = Astro.props;
const { data } = partner;

const tierBadges: Record<string, { bg: string; text: string; border: string }> = {
  'Host Venue': { 
    bg: 'bg-indigo-50 dark:bg-[#56548c]/30', 
    text: 'text-indigo-800 dark:text-[#bdaccf]', 
    border: 'border-indigo-200 dark:border-[#56548c]' 
  },
  'Academic Partner': { 
    bg: 'bg-pink-50 dark:bg-[#895294]/30', 
    text: 'text-pink-800 dark:text-pink-300', 
    border: 'border-pink-200 dark:border-[#895294]' 
  },
  'Ecosystem Partner': { 
    bg: 'bg-sky-50 dark:bg-[#6fb7e6]/20', 
    text: 'text-sky-800 dark:text-[#6fb7e6]', 
    border: 'border-sky-200 dark:border-[#6fb7e6]/50' 
  },
  'Sponsor': { 
    bg: 'bg-emerald-50 dark:bg-emerald-950/40', 
    text: 'text-emerald-800 dark:text-emerald-300', 
    border: 'border-emerald-200 dark:border-emerald-600/50' 
  },
};

const badgeStyle = tierBadges[data.tier] || { bg: 'bg-slate-100 dark:bg-slate-800', text: 'text-slate-700 dark:text-slate-300', border: 'border-slate-200 dark:border-slate-700' };
---

<div class="bg-white dark:bg-[#2a2948] rounded-xl border border-slate-200 dark:border-[#3e3c66] p-6 hover:border-[#56548c] shadow-sm hover:shadow-md transition-all flex flex-col justify-between group">
  <div>
    <div class="flex items-center justify-between gap-2 mb-4">
      <span class={`text-xs px-2.5 py-0.5 rounded-full font-semibold border ${badgeStyle.bg} ${badgeStyle.text} ${badgeStyle.border}`}>
        {data.tier}
      </span>
      <span class="text-xs text-slate-400">Verified Partner</span>
    </div>

    <h3 class="text-xl font-heading font-bold text-slate-900 dark:text-white group-hover:text-[#56548c] dark:group-hover:text-[#6fb7e6] transition-colors mb-2">
      {data.name}
    </h3>

    <p class="text-sm text-slate-600 dark:text-[#bdaccf] leading-relaxed mb-4">
      {data.description}
    </p>
  </div>

  <div class="pt-4 border-t border-slate-100 dark:border-[#3e3c66] flex items-center justify-between">
    <a
      href={data.websiteUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="text-xs font-semibold text-[#56548c] dark:text-[#6fb7e6] hover:underline flex items-center gap-1 transition-colors"
    >
      <span>Visit Partner Website</span> ↗
    </a>
  </div>
</div>
