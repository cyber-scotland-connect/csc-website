---
import type { CollectionEntry } from 'astro:content';

interface Props {
  partner: CollectionEntry<'partners'>;
}

const { partner } = Astro.props;
const { data } = partner;

const tierBadges: Record<string, { bg: string; text: string; border: string }> = {
  'Host Venue': { bg: 'bg-[#56548c]/30', text: 'text-[#bdaccf]', border: 'border-[#56548c]' },
  'Academic Partner': { bg: 'bg-[#895294]/30', text: 'text-pink-300', border: 'border-[#895294]' },
  'Ecosystem Partner': { bg: 'bg-[#6fb7e6]/20', text: 'text-[#6fb7e6]', border: 'border-[#6fb7e6]/50' },
  'Sponsor': { bg: 'bg-emerald-950/40', text: 'text-emerald-300', border: 'border-emerald-600/50' },
};

const badgeStyle = tierBadges[data.tier] || { bg: 'bg-slate-800', text: 'text-slate-300', border: 'border-slate-700' };
---

<div class="bg-[#2a2948] rounded-xl border border-[#3e3c66] p-6 hover:border-[#56548c] transition-all flex flex-col justify-between group">
  <div>
    <div class="flex items-center justify-between gap-2 mb-4">
      <span class={`text-xs px-2.5 py-0.5 rounded-full font-semibold border ${badgeStyle.bg} ${badgeStyle.text} ${badgeStyle.border}`}>
        {data.tier}
      </span>
      <span class="text-xs text-slate-400">Verified Partner</span>
    </div>

    <h3 class="text-xl font-heading font-bold text-white group-hover:text-[#6fb7e6] transition-colors mb-2">
      {data.name}
    </h3>

    <p class="text-sm text-[#bdaccf] leading-relaxed mb-4">
      {data.description}
    </p>
  </div>

  <div class="pt-4 border-t border-[#3e3c66] flex items-center justify-between">
    <a
      href={data.websiteUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="text-xs font-semibold text-[#6fb7e6] hover:text-white flex items-center gap-1 transition-colors group-hover:underline"
    >
      <span>Visit Partner Website</span> ↗
    </a>
  </div>
</div>
