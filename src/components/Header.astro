---
import AccessibilityBar from './AccessibilityBar.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const navLinks = [
  { href: `${base}/`, label: 'Home', active: pathname === `${base}` || pathname === '/' },
  { href: `${base}/events`, label: 'Events', active: pathname.startsWith(`${base}/events`) },
  { href: `${base}/leaders`, label: 'Leadership', active: pathname === `${base}/leaders` },
  { href: `${base}/partners`, label: 'Partners & Sponsors', active: pathname === `${base}/partners` },
  { href: `${base}/code-of-conduct`, label: 'Code of Conduct', active: pathname === `${base}/code-of-conduct` },
];
---

<header class="sticky top-0 z-50 bg-[#21203a] border-b border-[#3e3c66] transition-colors shadow-lg">
  <AccessibilityBar />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Brand Logo -->
      <a href={`${base}/`} class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-[#6fb7e6] rounded-lg p-1">
        <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-[#895294] to-[#56548c] flex items-center justify-center shadow-md group-hover:scale-105 transition-transform">
          <!-- Fragmented Shield Glyph -->
          <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v8" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h8" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-heading font-bold text-lg sm:text-xl tracking-wider text-white uppercase group-hover:text-[#6fb7e6] transition-colors">
            Cyber Scotland Connect
          </span>
          <span class="text-xs text-[#bdaccf] tracking-tight">Grassroots Security Community</span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-1" aria-label="Main Navigation">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={`px-3 py-2 rounded-md text-sm font-medium transition-colors ${
              link.active
                ? 'bg-[#382b5c] text-white border-b-2 border-[#895294]'
                : 'text-[#bdaccf] hover:text-white hover:bg-[#2a2948]'
            }`}
            aria-current={link.active ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
        <a
          href="https://www.meetup.com/cyberscotconnect/"
          target="_blank"
          rel="noopener noreferrer"
          class="ml-3 px-4 py-2 text-sm font-bold text-white bg-gradient-to-r from-[#895294] to-[#56548c] hover:from-[#9d5fa8] hover:to-[#6764a8] rounded-md shadow-md focus:outline-none focus:ring-2 focus:ring-[#6fb7e6] transition-all flex items-center gap-1.5"
        >
          <span>Join Meetup</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </nav>

      <!-- Mobile Menu Button -->
      <div class="md:hidden flex items-center">
        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2 rounded-md text-[#bdaccf] hover:text-white hover:bg-[#2a2948] focus:outline-none focus:ring-2 focus:ring-[#6fb7e6]"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle navigation menu"
        >
          <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-[#1b1a30] border-t border-[#3e3c66] px-4 pt-2 pb-4 space-y-1">
    {navLinks.map(link => (
      <a
        href={link.href}
        class={`block px-3 py-2 rounded-md text-base font-medium ${
          link.active
            ? 'bg-[#382b5c] text-white'
            : 'text-[#bdaccf] hover:text-white hover:bg-[#2a2948]'
        }`}
        aria-current={link.active ? 'page' : undefined}
      >
        {link.label}
      </a>
    ))}
    <a
      href="https://www.meetup.com/cyberscotconnect/"
      target="_blank"
      rel="noopener noreferrer"
      class="block w-full text-center mt-3 px-4 py-2.5 text-sm font-bold text-white bg-gradient-to-r from-[#895294] to-[#56548c] rounded-md shadow-md"
    >
      Join on Meetup.com ↗
    </a>
  </div>
</header>

<script is:inline>
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const burgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      const isExpanded = mobileBtn.getAttribute('aria-expanded') === 'true';
      mobileBtn.setAttribute('aria-expanded', !isExpanded ? 'true' : 'false');
      mobileMenu.classList.toggle('hidden');
      if (burgerIcon && closeIcon) {
        burgerIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
      }
    });
  }
</script>
