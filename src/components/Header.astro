---
import AccessibilityBar from './AccessibilityBar.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const navLinks = [
  { href: `${base}/`, label: 'Home', active: pathname === `${base}` || pathname === '/' },
  { href: `${base}/events`, label: 'Events', active: pathname.startsWith(`${base}/events`) },
  { href: `${base}/speakers`, label: 'Speakers', active: pathname.startsWith(`${base}/speakers`) },
  { href: `${base}/leaders`, label: 'Leadership', active: pathname === `${base}/leaders` },
  { href: `${base}/partners`, label: 'Partners', active: pathname === `${base}/partners` },
  { href: `${base}/faq`, label: 'FAQ', active: pathname === `${base}/faq` },
];
---

<header class="sticky top-0 z-50 bg-white/95 dark:bg-[#21203a]/95 backdrop-blur-md border-b border-slate-200 dark:border-[#3e3c66] transition-colors shadow-sm dark:shadow-lg">
  <AccessibilityBar />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-18 sm:h-20">
      <!-- Official Brand Logo -->
      <a href={`${base}/`} class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-[#6fb7e6] rounded-lg py-1 px-1 transition-transform hover:scale-[1.02]" aria-label="Cyber Scotland Connect Home">
        <img 
          src={`${base}/branding/logo-white-horizontal.png`} 
          alt="Cyber Scotland Connect" 
          class="h-11 sm:h-12 w-auto hidden dark:block" 
          width="280" 
          height="48"
        />
        <img 
          src={`${base}/branding/logo-fullcolor-horizontal.png`} 
          alt="Cyber Scotland Connect" 
          class="h-11 sm:h-12 w-auto block dark:hidden" 
          width="280" 
          height="48"
        />
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-1.5" aria-label="Main Navigation">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={`px-3 py-1.5 rounded-lg text-sm font-semibold transition-all ${
              link.active
                ? 'bg-purple-50 dark:bg-[#382b5c] text-[#895294] dark:text-white border-b-2 border-[#895294]'
                : 'text-slate-600 dark:text-[#bdaccf] hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-[#2a2948]'
            }`}
            aria-current={link.active ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}

        <!-- Accessibility / Display Toggle Button -->
        <button
          type="button"
          class="a11y-nav-toggle-btn ml-1 px-2.5 py-1.5 rounded-lg text-xs font-semibold text-slate-700 dark:text-[#bdaccf] hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-[#2a2948] border border-slate-300 dark:border-[#3e3c66] flex items-center gap-1.5 focus:outline-none focus:ring-2 focus:ring-[#6fb7e6] transition-all"
          aria-label="Toggle accessibility and display options"
          title="Toggle display & accessibility preferences (Theme, Dyslexia Font, Text Size)"
        >
          <span class="text-sm">♿</span>
          <span class="hidden lg:inline">Display</span>
        </button>

        <a
          href="https://www.meetup.com/cyberscotconnect/"
          target="_blank"
          rel="noopener noreferrer"
          class="ml-2 px-3.5 py-1.5 text-sm font-bold text-white bg-gradient-to-r from-[#895294] to-[#56548c] hover:from-[#9d5fa8] hover:to-[#6764a8] rounded-lg shadow-sm hover:shadow-md focus:outline-none focus:ring-2 focus:ring-[#6fb7e6] transition-all flex items-center gap-1.5"
        >
          <span>Join Meetup</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </nav>

      <!-- Mobile Menu & Accessibility Buttons -->
      <div class="md:hidden flex items-center gap-1.5">
        <button
          type="button"
          class="a11y-nav-toggle-btn p-2 rounded-lg text-slate-600 dark:text-[#bdaccf] hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-[#2a2948] border border-slate-200 dark:border-[#3e3c66] focus:outline-none focus:ring-2 focus:ring-[#6fb7e6] transition-colors"
          aria-label="Toggle accessibility options"
          title="Display options"
        >
          <span class="text-base leading-none">♿</span>
        </button>

        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2 rounded-lg text-slate-600 dark:text-[#bdaccf] hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-[#2a2948] focus:outline-none focus:ring-2 focus:ring-[#6fb7e6] transition-colors"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle navigation menu"
        >
          <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white/98 dark:bg-[#1b1a30]/98 backdrop-blur-lg border-t border-slate-200 dark:border-[#3e3c66] px-4 pt-3 pb-5 space-y-1.5 shadow-xl">
    {navLinks.map(link => (
      <a
        href={link.href}
        class={`block px-3.5 py-2.5 rounded-lg text-base font-semibold ${
          link.active
            ? 'bg-purple-50 dark:bg-[#382b5c] text-[#895294] dark:text-white'
            : 'text-slate-700 dark:text-[#bdaccf] hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-[#2a2948]'
        }`}
        aria-current={link.active ? 'page' : undefined}
      >
        {link.label}
      </a>
    ))}
    <a
      href="https://www.meetup.com/cyberscotconnect/"
      target="_blank"
      rel="noopener noreferrer"
      class="block w-full text-center mt-4 px-4 py-3 text-sm font-bold text-white bg-gradient-to-r from-[#895294] to-[#56548c] rounded-lg shadow-md"
    >
      Join on Meetup.com ↗
    </a>
  </div>
</header>

<script is:inline>
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const burgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      const isExpanded = mobileBtn.getAttribute('aria-expanded') === 'true';
      mobileBtn.setAttribute('aria-expanded', !isExpanded ? 'true' : 'false');
      mobileMenu.classList.toggle('hidden');
      if (burgerIcon && closeIcon) {
        burgerIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
      }
    });
  }

  // Hook all .a11y-nav-toggle-btn clicks to dispatch the custom event
  document.querySelectorAll('.a11y-nav-toggle-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('toggle-a11y-bar'));
    });
  });
</script>
