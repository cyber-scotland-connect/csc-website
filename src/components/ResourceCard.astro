---
import type { CollectionEntry } from 'astro:content';

interface Props {
  resource: CollectionEntry<'resources'>;
}

const { resource } = Astro.props;
const { data } = resource;

const typeBadges: Record<string, { bg: string; text: string; border: string }> =
  {
    'Community Project': {
      bg: 'bg-emerald-50 dark:bg-emerald-950/40',
      text: 'text-emerald-800 dark:text-emerald-300',
      border: 'border-emerald-200 dark:border-emerald-700/50',
    },
    'Open Source Tool': {
      bg: 'bg-indigo-50 dark:bg-[#56548c]/30',
      text: 'text-indigo-800 dark:text-[#bdaccf]',
      border: 'border-indigo-200 dark:border-[#56548c]',
    },
    'Living Standard': {
      bg: 'bg-sky-50 dark:bg-[#6fb7e6]/20',
      text: 'text-sky-800 dark:text-sky-200',
      border: 'border-sky-200 dark:border-[#6fb7e6]/50',
    },
    'Interactive Lab': {
      bg: 'bg-amber-50 dark:bg-amber-950/40',
      text: 'text-amber-800 dark:text-amber-300',
      border: 'border-amber-200 dark:border-amber-700/50',
    },
    'Public Body / Advisory': {
      bg: 'bg-purple-50 dark:bg-[#895294]/30',
      text: 'text-purple-800 dark:text-purple-300',
      border: 'border-purple-200 dark:border-[#895294]',
    },
  };

const badgeStyle = typeBadges[data.type] || {
  bg: 'bg-slate-100 dark:bg-slate-800',
  text: 'text-slate-700 dark:text-slate-300',
  border: 'border-slate-200 dark:border-slate-700',
};
---

<article
  class="card-tactile bg-white dark:bg-[#2a2948] rounded-2xl border border-slate-200 dark:border-[#3e3c66] p-6 hover:border-[#895294] dark:hover:border-[#6fb7e6] shadow-sm hover:shadow-md transition-all flex flex-col justify-between group"
>
  <div>
    <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
      <span
        class={`text-[11px] px-2.5 py-0.5 rounded-full font-semibold border ${badgeStyle.bg} ${badgeStyle.text} ${badgeStyle.border}`}
      >
        {data.type}
      </span>
      {
        data.isScottishOrUK && (
          <span class="inline-flex items-center gap-1 text-[11px] px-2 py-0.5 rounded-full font-semibold bg-blue-50 dark:bg-blue-950/50 text-blue-800 dark:text-blue-300 border border-blue-200 dark:border-blue-700/50">
            <span aria-hidden="true">🏴󠁧󠁢󠁳󠁣󠁴󠁿</span>
            <span>Local / UK</span>
          </span>
        )
      }
    </div>

    <h3
      class="text-lg font-heading font-bold text-slate-900 dark:text-white group-hover:text-[#895294] dark:group-hover:text-[#6fb7e6] transition-colors leading-snug mb-2"
    >
      {data.title}
    </h3>

    <p class="text-xs text-slate-600 dark:text-[#bdaccf] leading-relaxed mb-4">
      {data.description}
    </p>
  </div>

  <div
    class="pt-4 border-t border-slate-100 dark:border-[#3e3c66] flex items-center justify-between"
  >
    <span class="text-[11px] font-medium text-slate-400 dark:text-slate-400">
      {data.category}
    </span>
    <a
      href={data.url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 text-xs font-bold text-[#895294] dark:text-[#6fb7e6] hover:underline focus:outline-none focus:ring-2 focus:ring-[#895294] dark:focus:ring-[#6fb7e6] rounded px-1 -mx-1 py-0.5 transition-colors"
      aria-label={`Open ${data.title} website in new tab`}
    >
      <span>Visit Resource</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-3.5 h-3.5"
        viewBox="0 0 20 20"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          fill-rule="evenodd"
          d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z"
          clip-rule="evenodd"></path>
      </svg>
    </a>
  </div>
</article>
