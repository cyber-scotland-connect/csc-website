---
import type { CollectionEntry } from 'astro:content';

interface Props {
  event: CollectionEntry<'events'>;
}

const { event } = Astro.props;
const { data, slug } = event;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const eventDate = new Date(data.date);
const isUpcoming = eventDate.getTime() >= new Date().setHours(0, 0, 0, 0);

const monthAbbr = eventDate.toLocaleDateString('en-GB', { month: 'short' }).toUpperCase();
const dayNumber = eventDate.toLocaleDateString('en-GB', { day: 'numeric' });

const formattedFullDate = eventDate.toLocaleDateString('en-GB', {
  weekday: 'short',
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

const chapterColors: Record<string, string> = {
  Edinburgh: 'bg-[#56548c] text-white',
  Glasgow: 'bg-[#382b5c] text-purple-100 border border-[#56548c]',
  Dundee: 'bg-[#895294] text-white',
  Virtual: 'bg-sky-50 dark:bg-[#21203a] text-sky-800 dark:text-[#6fb7e6] border border-sky-300 dark:border-[#6fb7e6]',
  'Scotland-wide': 'bg-slate-100 dark:bg-[#1b1a30] text-slate-800 dark:text-white border border-slate-300 dark:border-[#3e3c66]',
  Aberdeen: 'bg-slate-700 text-white',
};
---

<article class="bg-white dark:bg-[#2a2948] rounded-2xl border border-slate-200 dark:border-[#3e3c66] p-6 hover:border-[#895294] shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between group">
  <div>
    <!-- Top Row: Date badge + Metadata -->
    <div class="flex items-start gap-3.5 mb-4">
      <div class="flex flex-col items-center justify-center w-14 h-14 rounded-xl bg-slate-100 dark:bg-[#21203a] border border-slate-200 dark:border-[#3e3c66] shrink-0 text-center shadow-inner group-hover:border-[#895294] transition-colors">
        <span class="text-[11px] uppercase font-bold tracking-widest text-[#895294] dark:text-[#6fb7e6] leading-none">{monthAbbr}</span>
        <span class="text-xl font-heading font-bold text-slate-900 dark:text-white leading-none mt-1">{dayNumber}</span>
      </div>

      <div class="flex-1 min-w-0">
        <div class="flex flex-wrap items-center gap-1.5 mb-1.5">
          <span class={`text-xs px-2.5 py-0.5 rounded-full font-bold ${chapterColors[data.city] || 'bg-[#56548c] text-white'}`}>
            {data.city}
          </span>
          {data.isPartnerEvent ? (
            <span class="text-xs px-2 py-0.5 rounded-full font-semibold bg-pink-100 dark:bg-[#895294]/30 text-pink-800 dark:text-pink-300 border border-pink-200 dark:border-[#895294]">
              Partner: {data.partnerName || 'Ecosystem'}
            </span>
          ) : (
            <span class="text-xs px-2 py-0.5 rounded-full font-semibold bg-sky-100 dark:bg-[#6fb7e6]/20 text-sky-800 dark:text-[#6fb7e6] border border-sky-200 dark:border-[#6fb7e6]/40">
              CSC Gathering
            </span>
          )}
        </div>
        <span class={`inline-block text-[11px] font-bold px-2 py-0.5 rounded-md ${isUpcoming ? 'bg-emerald-100 text-emerald-800 border border-emerald-300 dark:bg-emerald-950 dark:text-emerald-300 dark:border-emerald-600' : 'bg-slate-100 text-slate-500 border border-slate-200 dark:bg-slate-800 dark:text-slate-400 dark:border-slate-700'}`}>
          {isUpcoming ? '● Upcoming Meetup' : 'Archived'}
        </span>
      </div>
    </div>

    <!-- Title -->
    <h3 class="text-xl font-heading font-bold text-slate-900 dark:text-white group-hover:text-[#895294] dark:group-hover:text-[#6fb7e6] transition-colors mb-2.5 line-clamp-2">
      <a href={`${base}/events/${slug}`} class="focus:outline-none focus:ring-2 focus:ring-[#6fb7e6] rounded">
        {data.title}
      </a>
    </h3>

    <!-- Date & Location details -->
    <div class="space-y-1.5 text-xs sm:text-sm text-slate-600 dark:text-[#bdaccf] mb-4">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-[#895294] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="font-medium text-slate-900 dark:text-white">{formattedFullDate}</span>
        {data.time && <span class="text-slate-500 dark:text-slate-400">({data.time})</span>}
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-[#56548c] dark:text-[#6fb7e6] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span class="truncate">{data.location}</span>
      </div>
    </div>

    <!-- Speakers Preview -->
    {data.speakers && data.speakers.length > 0 && (
      <div class="mb-4 pt-3 border-t border-slate-100 dark:border-[#3e3c66]/60">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 block mb-1.5">Speakers:</span>
        <ul class="text-xs text-slate-600 dark:text-[#bdaccf] space-y-1">
          {data.speakers.map(speaker => (
            <li class="flex items-baseline gap-1.5">
              <span class="text-[#895294] dark:text-[#6fb7e6] font-semibold">• {speaker.name}</span>
              <span class="text-slate-500 dark:text-slate-400 truncate">— "{speaker.talkTitle}"</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <!-- Accessibility Badges & Action Links -->
  <div class="pt-4 border-t border-slate-100 dark:border-[#3e3c66] flex flex-wrap items-center justify-between gap-2.5 text-xs">
    <div class="flex items-center gap-1.5 text-slate-500 dark:text-slate-400" title="Venue Accessibility">
      {data.accessibility.stepFree && (
        <span class="flex items-center gap-1 bg-slate-100 dark:bg-[#21203a] px-2 py-0.5 rounded-md border border-slate-200 dark:border-[#3e3c66] font-medium" title="Step-free accessible venue">
          ♿ <span class="hidden sm:inline">Step-free</span>
        </span>
      )}
      {data.accessibility.hearingLoop && (
        <span class="flex items-center gap-1 bg-slate-100 dark:bg-[#21203a] px-2 py-0.5 rounded-md border border-slate-200 dark:border-[#3e3c66] font-medium" title="Induction Hearing Loop available">
          🦻 <span class="hidden sm:inline">Hearing Loop</span>
        </span>
      )}
    </div>

    <div class="flex items-center gap-2">
      <a
        href={`${base}/events/${slug}`}
        class="text-[#895294] dark:text-[#6fb7e6] hover:underline font-bold flex items-center gap-1 transition-colors py-1"
      >
        <span>Details</span> →
      </a>
      {data.meetupUrl && (
        <a
          href={data.meetupUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-[#895294] hover:bg-[#9d5fa8] text-white px-3 py-1.5 rounded-lg font-bold transition-all shadow-sm"
        >
          Meetup ↗
        </a>
      )}
      {data.registrationUrl && (
        <a
          href={data.registrationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-[#56548c] hover:bg-[#6764a8] text-white px-3 py-1.5 rounded-lg font-bold transition-all shadow-sm"
        >
          Register ↗
        </a>
      )}
    </div>
  </div>
</article>
