---
import type { CollectionEntry } from 'astro:content';

interface Props {
  event: CollectionEntry<'events'>;
}

const { event } = Astro.props;
const { data, slug } = event;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const eventDate = new Date(data.date);
const isUpcoming = eventDate.getTime() >= new Date().setHours(0, 0, 0, 0);

const formattedDate = eventDate.toLocaleDateString('en-GB', {
  weekday: 'short',
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

const chapterColors: Record<string, string> = {
  Edinburgh: 'bg-[#56548c] text-white',
  Glasgow: 'bg-[#382b5c] text-[#bdaccf] border border-[#56548c]',
  Dundee: 'bg-[#895294] text-white',
  Virtual: 'bg-[#21203a] text-[#6fb7e6] border border-[#6fb7e6]',
  'Scotland-wide': 'bg-[#1b1a30] text-white border border-[#3e3c66]',
  Aberdeen: 'bg-[#3e3c66] text-white',
};
---

<article class="bg-[#2a2948] rounded-xl border border-[#3e3c66] p-6 hover:border-[#56548c] hover:shadow-xl transition-all flex flex-col justify-between group">
  <div>
    <!-- Top Metadata Tags -->
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
      <div class="flex flex-wrap items-center gap-2">
        <span class={`text-xs px-2.5 py-0.5 rounded-full font-semibold ${chapterColors[data.city] || 'bg-[#56548c] text-white'}`}>
          {data.city}
        </span>
        {data.isPartnerEvent ? (
          <span class="text-xs px-2.5 py-0.5 rounded-full font-medium bg-[#895294]/30 text-pink-300 border border-[#895294]">
            Partner: {data.partnerName || 'Ecosystem Event'}
          </span>
        ) : (
          <span class="text-xs px-2.5 py-0.5 rounded-full font-medium bg-[#6fb7e6]/20 text-[#6fb7e6] border border-[#6fb7e6]/40">
            CSC Official
          </span>
        )}
      </div>

      <span class={`text-xs font-semibold px-2 py-0.5 rounded ${isUpcoming ? 'bg-emerald-950 text-emerald-300 border border-emerald-600' : 'bg-slate-800 text-slate-400'}`}>
        {isUpcoming ? '● Upcoming' : 'Archived'}
      </span>
    </div>

    <!-- Title -->
    <h3 class="text-xl font-heading font-bold text-white group-hover:text-[#6fb7e6] transition-colors mb-2 line-clamp-2">
      <a href={`${base}/events/${slug}`} class="focus:outline-none focus:ring-2 focus:ring-[#6fb7e6] rounded">
        {data.title}
      </a>
    </h3>

    <!-- Date & Location -->
    <div class="space-y-1.5 text-sm text-[#bdaccf] mb-4">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-[#895294] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span class="font-medium text-white">{formattedDate}</span>
        {data.time && <span class="text-slate-400">({data.time})</span>}
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-[#6fb7e6] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span class="truncate">{data.location}</span>
      </div>
    </div>

    <!-- Speakers Preview -->
    {data.speakers && data.speakers.length > 0 && (
      <div class="mb-4 pt-3 border-t border-[#3e3c66]/60">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 block mb-1.5">Speakers:</span>
        <ul class="text-xs text-[#bdaccf] space-y-1">
          {data.speakers.map(speaker => (
            <li class="flex items-baseline gap-1.5">
              <span class="text-[#6fb7e6] font-medium">• {speaker.name}</span>
              <span class="text-slate-400 truncate">— "{speaker.talkTitle}"</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <!-- Accessibility Badges & Links -->
  <div class="pt-4 border-t border-[#3e3c66] flex flex-wrap items-center justify-between gap-3 text-xs">
    <div class="flex items-center gap-2 text-slate-400" title="Venue Accessibility">
      {data.accessibility.stepFree && (
        <span class="flex items-center gap-1 bg-[#21203a] px-2 py-0.5 rounded border border-[#3e3c66]" title="Step-free accessible venue">
          ♿ <span class="hidden sm:inline">Step-free</span>
        </span>
      )}
      {data.accessibility.hearingLoop && (
        <span class="flex items-center gap-1 bg-[#21203a] px-2 py-0.5 rounded border border-[#3e3c66]" title="Induction Hearing Loop available">
          🦻 <span class="hidden sm:inline">Hearing Loop</span>
        </span>
      )}
    </div>

    <div class="flex items-center gap-2">
      <a
        href={`${base}/events/${slug}`}
        class="text-[#6fb7e6] hover:text-white font-medium flex items-center gap-1 transition-colors"
      >
        <span>Details</span> →
      </a>
      {data.meetupUrl && (
        <a
          href={data.meetupUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-[#895294] hover:bg-[#9d5fa8] text-white px-2.5 py-1 rounded font-medium transition-colors"
        >
          Meetup ↗
        </a>
      )}
      {data.registrationUrl && (
        <a
          href={data.registrationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-[#56548c] hover:bg-[#6764a8] text-white px-2.5 py-1 rounded font-medium transition-colors"
        >
          Register ↗
        </a>
      )}
    </div>
  </div>
</article>
