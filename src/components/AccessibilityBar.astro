---
// Compact, collapsible Accessibility toolbar with Theme, Dyslexia Font, and Text Sizing controls.
// Completely hidden when collapsed to save maximum vertical space.
---

<aside 
  class="hidden bg-slate-100 dark:bg-[#1b1a30] text-slate-700 dark:text-[#bdaccf] border-b border-slate-200 dark:border-[#3e3c66] text-xs select-none transition-all duration-200"
  id="a11y-bar"
  aria-label="Accessibility & Display Preferences"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-1.5 sm:py-1">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <!-- Label -->
      <div class="flex items-center gap-1.5 font-medium text-slate-700 dark:text-slate-300">
        <svg class="w-3.5 h-3.5 text-[#895294] dark:text-[#6fb7e6]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
        <span class="font-semibold text-xs text-slate-900 dark:text-white">Accessibility & Display:</span>
      </div>

      <!-- Controls group -->
      <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
        <!-- Font Family Selector -->
        <button 
          id="toggle-font-btn" 
          type="button" 
          class="px-2 py-0.5 rounded border border-slate-300 dark:border-[#56548c] bg-white dark:bg-[#2a2948] hover:bg-slate-50 dark:hover:bg-[#382b5c] text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#6fb7e6] transition-all flex items-center gap-1"
          aria-pressed="false"
          title="Toggle Dyslexia-Friendly Atkinson Hyperlegible font"
        >
          <span class="font-bold">🔤</span>
          <span id="font-toggle-label">Dyslexia Font: Off</span>
        </button>

        <!-- Text Size Multipliers -->
        <div class="flex items-center gap-0.5 border border-slate-300 dark:border-[#56548c] rounded bg-white dark:bg-[#2a2948] p-0.5" role="group" aria-label="Text Size Controls">
          <span class="text-slate-500 dark:text-slate-400 text-[10px] uppercase font-bold px-1 hidden sm:inline">Size</span>
          <button 
            type="button" 
            data-size="normal"
            class="size-btn px-1.5 py-0.2 rounded text-xs font-semibold focus:outline-none focus:ring-1 focus:ring-[#6fb7e6]"
            aria-label="Default text size (100%)"
          >
            A
          </button>
          <button 
            type="button" 
            data-size="lg"
            class="size-btn px-1.5 py-0.2 rounded text-xs font-bold focus:outline-none focus:ring-1 focus:ring-[#6fb7e6]"
            aria-label="Large text size (112%)"
          >
            A+
          </button>
          <button 
            type="button" 
            data-size="xl"
            class="size-btn px-1.5 py-0.2 rounded text-xs font-extrabold focus:outline-none focus:ring-1 focus:ring-[#6fb7e6]"
            aria-label="Extra large text size (125%)"
          >
            A++
          </button>
        </div>

        <!-- High Contrast Toggle -->
        <button 
          id="toggle-contrast-btn" 
          type="button" 
          class="px-2 py-0.5 rounded border border-slate-300 dark:border-[#56548c] bg-white dark:bg-[#2a2948] hover:bg-slate-50 dark:hover:bg-[#382b5c] text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#6fb7e6] transition-all flex items-center gap-1"
          aria-pressed="false"
          title="Toggle high contrast display mode"
        >
          <span aria-hidden="true">◐</span>
          <span id="contrast-toggle-label">Contrast: Off</span>
        </button>

        <!-- Theme Switcher (Dark / Light) -->
        <button 
          id="theme-toggle-btn" 
          type="button" 
          class="px-2 py-0.5 rounded border border-slate-300 dark:border-[#56548c] bg-white dark:bg-[#2a2948] hover:bg-slate-50 dark:hover:bg-[#382b5c] text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#6fb7e6] transition-all flex items-center gap-1"
          aria-label="Toggle dark and light theme"
        >
          <span id="theme-icon" aria-hidden="true">🌙</span>
          <span id="theme-label">Dark</span>
        </button>

        <!-- Collapse / Close Button (Completely closes bar to save 100% space) -->
        <button
          id="a11y-collapse-btn"
          type="button"
          class="ml-1 px-2 py-0.5 rounded border border-slate-300 dark:border-[#3e3c66] bg-slate-200 dark:bg-[#252440] hover:bg-slate-300 dark:hover:bg-[#382b5c] text-slate-700 dark:text-slate-200 font-semibold flex items-center gap-1 focus:outline-none focus:ring-2 focus:ring-[#6fb7e6] transition-all"
          aria-label="Hide accessibility bar"
          title="Hide toolbar and save screen space"
        >
          <span>Hide</span>
          <span aria-hidden="true">✕</span>
        </button>
      </div>
    </div>
  </div>
</aside>

<script is:inline>
  (function() {
    const a11yBar = document.getElementById('a11y-bar');
    const collapseBtn = document.getElementById('a11y-collapse-btn');

    function syncNavToggleButtons(isOpen) {
      const toggleBtns = document.querySelectorAll('.a11y-nav-toggle-btn');
      toggleBtns.forEach(btn => {
        btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        if (isOpen) {
          btn.classList.add('bg-purple-100', 'dark:bg-[#382b5c]', 'text-[#895294]', 'dark:text-white');
        } else {
          btn.classList.remove('bg-purple-100', 'dark:bg-[#382b5c]', 'text-[#895294]', 'dark:text-white');
        }
      });
    }

    function setBarVisibility(isOpen) {
      if (!a11yBar) return;
      if (isOpen) {
        a11yBar.classList.remove('hidden');
        localStorage.setItem('csc-a11y-collapsed', 'false');
      } else {
        a11yBar.classList.add('hidden');
        localStorage.setItem('csc-a11y-collapsed', 'true');
      }
      syncNavToggleButtons(isOpen);
    }

    // Window event listener so Header buttons can toggle the bar
    window.addEventListener('toggle-a11y-bar', () => {
      const isCurrentlyHidden = a11yBar ? a11yBar.classList.contains('hidden') : true;
      setBarVisibility(isCurrentlyHidden);
    });

    if (collapseBtn) {
      collapseBtn.addEventListener('click', () => setBarVisibility(false));
    }

    // First-time load check:
    // If user has NEVER explicitly collapsed it, show it on first load!
    // If they HAVE collapsed it, keep it hidden so 0 space is wasted!
    const isExplicitlyCollapsed = localStorage.getItem('csc-a11y-collapsed') === 'true';
    if (!isExplicitlyCollapsed) {
      setBarVisibility(true);
    } else {
      setBarVisibility(false);
    }

    // Theme toggle
    const themeBtn = document.getElementById('theme-toggle-btn');
    const themeIcon = document.getElementById('theme-icon');
    const themeLabel = document.getElementById('theme-label');

    function updateThemeUI(theme) {
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
        if (themeIcon) themeIcon.textContent = '☀️';
        if (themeLabel) themeLabel.textContent = 'Light';
      } else {
        document.documentElement.classList.remove('light');
        document.documentElement.classList.add('dark');
        if (themeIcon) themeIcon.textContent = '🌙';
        if (themeLabel) themeLabel.textContent = 'Dark';
      }
    }

    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.contains('dark') || !document.documentElement.classList.contains('light');
        const nextTheme = isDark ? 'light' : 'dark';
        localStorage.setItem('csc-theme', nextTheme);
        updateThemeUI(nextTheme);
      });
    }

    // Font toggle
    const fontBtn = document.getElementById('toggle-font-btn');
    const fontLabel = document.getElementById('font-toggle-label');

    function updateFontUI(isDyslexic) {
      if (isDyslexic) {
        document.documentElement.classList.add('font-dyslexic');
        if (fontBtn) fontBtn.setAttribute('aria-pressed', 'true');
        if (fontLabel) fontLabel.textContent = 'Dyslexia Font: On';
      } else {
        document.documentElement.classList.remove('font-dyslexic');
        if (fontBtn) fontBtn.setAttribute('aria-pressed', 'false');
        if (fontLabel) fontLabel.textContent = 'Dyslexia Font: Off';
      }
    }

    if (fontBtn) {
      fontBtn.addEventListener('click', () => {
        const isDyslexic = document.documentElement.classList.contains('font-dyslexic');
        const nextState = !isDyslexic;
        localStorage.setItem('csc-font-dyslexic', nextState ? 'true' : 'false');
        updateFontUI(nextState);
      });
    }

    // Text size
    const sizeBtns = document.querySelectorAll('.size-btn');
    function applyTextSize(size) {
      document.documentElement.classList.remove('text-scale-normal', 'text-scale-lg', 'text-scale-xl');
      document.documentElement.classList.add('text-scale-' + size);
      localStorage.setItem('csc-text-size', size);
      sizeBtns.forEach(btn => {
        if (btn.getAttribute('data-size') === size) {
          btn.classList.add('bg-[#895294]', 'text-white');
          btn.classList.remove('text-slate-700', 'dark:text-slate-300');
        } else {
          btn.classList.remove('bg-[#895294]', 'text-white');
          btn.classList.add('text-slate-700', 'dark:text-slate-300');
        }
      });
    }

    sizeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const size = btn.getAttribute('data-size') || 'normal';
        applyTextSize(size);
      });
    });

    // High contrast
    const contrastBtn = document.getElementById('toggle-contrast-btn');
    const contrastLabel = document.getElementById('contrast-toggle-label');

    function updateContrastUI(isHigh) {
      if (isHigh) {
        document.documentElement.classList.add('high-contrast');
        if (contrastBtn) {
          contrastBtn.setAttribute('aria-pressed', 'true');
          contrastBtn.classList.add('bg-[#895294]', 'text-white', 'border-[#895294]');
          contrastBtn.classList.remove('bg-white', 'dark:bg-[#2a2948]', 'text-slate-800', 'dark:text-white');
        }
        if (contrastLabel) contrastLabel.textContent = 'Contrast: On';
      } else {
        document.documentElement.classList.remove('high-contrast');
        if (contrastBtn) {
          contrastBtn.setAttribute('aria-pressed', 'false');
          contrastBtn.classList.remove('bg-[#895294]', 'text-white', 'border-[#895294]');
          contrastBtn.classList.add('bg-white', 'dark:bg-[#2a2948]', 'text-slate-800', 'dark:text-white');
        }
        if (contrastLabel) contrastLabel.textContent = 'Contrast: Off';
      }
    }

    if (contrastBtn) {
      contrastBtn.addEventListener('click', () => {
        const isHigh = document.documentElement.classList.contains('high-contrast');
        const nextState = !isHigh;
        localStorage.setItem('csc-high-contrast', nextState ? 'true' : 'false');
        updateContrastUI(nextState);
      });
    }

    // Init from localStorage
    const savedTheme = localStorage.getItem('csc-theme') || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    updateThemeUI(savedTheme);

    const savedFont = localStorage.getItem('csc-font-dyslexic') === 'true';
    updateFontUI(savedFont);

    const savedSize = localStorage.getItem('csc-text-size') || 'normal';
    applyTextSize(savedSize);

    const savedContrast = localStorage.getItem('csc-high-contrast') === 'true';
    updateContrastUI(savedContrast);
  })();
</script>
