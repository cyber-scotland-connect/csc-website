---
// Accessibility toolbar with Theme, Dyslexia Font, and Text Sizing controls (Collapsible)
---

<aside 
  class="bg-slate-100 dark:bg-[#1b1a30] text-slate-700 dark:text-[#bdaccf] border-b border-slate-200 dark:border-[#3e3c66] text-xs select-none transition-all duration-200"
  id="a11y-bar"
  aria-label="Accessibility Preferences"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Collapsed Slim State (Only visible when collapsed) -->
    <div id="a11y-collapsed-view" class="hidden py-1 items-center justify-between">
      <div class="flex items-center gap-1.5 font-semibold text-slate-700 dark:text-slate-300">
        <svg class="w-3.5 h-3.5 text-[#895294] dark:text-[#6fb7e6]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
        <span>Accessibility & Display</span>
      </div>

      <button
        id="a11y-expand-btn"
        type="button"
        class="px-2.5 py-0.5 rounded-md border border-slate-300 dark:border-[#56548c] bg-white dark:bg-[#2a2948] hover:bg-slate-50 dark:hover:bg-[#382b5c] text-slate-800 dark:text-white font-semibold flex items-center gap-1 focus:outline-none focus:ring-2 focus:ring-[#6fb7e6] transition-all shadow-sm"
        aria-expanded="false"
        aria-controls="a11y-controls-container"
      >
        <span>Display Options</span>
        <span aria-hidden="true">▾</span>
      </button>
    </div>

    <!-- Expanded Full Controls (Default for first-time visitors) -->
    <div id="a11y-controls-container" class="py-1.5 flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-1.5 font-medium text-slate-700 dark:text-slate-300">
        <svg class="w-3.5 h-3.5 text-[#895294] dark:text-[#6fb7e6]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
        <span class="font-semibold">Accessibility & Display Options</span>
      </div>

      <div class="flex flex-wrap items-center gap-2 sm:gap-3">
        <!-- Font Family Selector -->
        <div class="flex items-center gap-1">
          <button 
            id="toggle-font-btn" 
            type="button" 
            class="px-2.5 py-0.5 rounded border border-slate-300 dark:border-[#56548c] bg-white dark:bg-[#2a2948] hover:bg-slate-50 dark:hover:bg-[#382b5c] text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#6fb7e6] transition-all flex items-center gap-1"
            aria-pressed="false"
            title="Toggle Dyslexia-Friendly Atkinson / OpenDyslexic font"
          >
            <span class="font-bold">🔤</span>
            <span id="font-toggle-label">Dyslexia Font: Off</span>
          </button>
        </div>

        <!-- Text Size Multipliers -->
        <div class="flex items-center gap-0.5" role="group" aria-label="Text Size Controls">
          <span class="text-slate-500 dark:text-slate-400 mr-1 hidden sm:inline">Size:</span>
          <button 
            type="button" 
            data-size="normal"
            class="size-btn px-2 py-0.5 rounded border border-slate-300 dark:border-[#56548c] bg-white dark:bg-[#2a2948] hover:bg-slate-50 dark:hover:bg-[#382b5c] text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#6fb7e6] font-medium"
            aria-label="Default text size (100%)"
          >
            A
          </button>
          <button 
            type="button" 
            data-size="lg"
            class="size-btn px-2 py-0.5 rounded border border-slate-300 dark:border-[#56548c] bg-white dark:bg-[#2a2948] hover:bg-slate-50 dark:hover:bg-[#382b5c] text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#6fb7e6] font-semibold text-sm"
            aria-label="Large text size (112%)"
          >
            A+
          </button>
          <button 
            type="button" 
            data-size="xl"
            class="size-btn px-2 py-0.5 rounded border border-slate-300 dark:border-[#56548c] bg-white dark:bg-[#2a2948] hover:bg-slate-50 dark:hover:bg-[#382b5c] text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#6fb7e6] font-bold text-base"
            aria-label="Extra large text size (125%)"
          >
            A++
          </button>
        </div>

        <!-- High Contrast Toggle -->
        <button 
          id="toggle-contrast-btn" 
          type="button" 
          class="px-2.5 py-0.5 rounded border border-slate-300 dark:border-[#56548c] bg-white dark:bg-[#2a2948] hover:bg-slate-50 dark:hover:bg-[#382b5c] text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#6fb7e6] transition-all hidden md:inline-flex items-center gap-1"
          aria-pressed="false"
        >
          <span>High Contrast</span>
        </button>

        <!-- Theme Switcher (Dark / Light) -->
        <button 
          id="theme-toggle-btn" 
          type="button" 
          class="px-2.5 py-0.5 rounded border border-slate-300 dark:border-[#56548c] bg-white dark:bg-[#2a2948] hover:bg-slate-50 dark:hover:bg-[#382b5c] text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#6fb7e6] transition-all flex items-center gap-1"
          aria-label="Toggle dark and light theme"
        >
          <span id="theme-icon" aria-hidden="true">🌙</span>
          <span id="theme-label">Dark</span>
        </button>

        <!-- Collapse Button -->
        <button
          id="a11y-collapse-btn"
          type="button"
          class="ml-1 px-2 py-0.5 rounded border border-slate-300 dark:border-[#3e3c66] bg-slate-200 dark:bg-[#21203a] hover:bg-slate-300 dark:hover:bg-[#382b5c] text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white font-medium flex items-center gap-1 focus:outline-none focus:ring-2 focus:ring-[#6fb7e6] transition-all"
          aria-label="Collapse accessibility toolbar"
          title="Collapse toolbar"
        >
          <span class="hidden sm:inline">Hide</span>
          <span aria-hidden="true">▲</span>
        </button>
      </div>
    </div>
  </div>
</aside>

<script is:inline>
  (function() {
    const collapsedView = document.getElementById('a11y-collapsed-view');
    const controlsContainer = document.getElementById('a11y-controls-container');
    const collapseBtn = document.getElementById('a11y-collapse-btn');
    const expandBtn = document.getElementById('a11y-expand-btn');

    function setCollapsedState(collapsed) {
      if (collapsed) {
        if (controlsContainer) controlsContainer.classList.add('hidden');
        if (collapsedView) {
          collapsedView.classList.remove('hidden');
          collapsedView.classList.add('flex');
        }
        if (expandBtn) expandBtn.setAttribute('aria-expanded', 'false');
        localStorage.setItem('csc-a11y-collapsed', 'true');
      } else {
        if (collapsedView) {
          collapsedView.classList.remove('flex');
          collapsedView.classList.add('hidden');
        }
        if (controlsContainer) controlsContainer.classList.remove('hidden');
        if (expandBtn) expandBtn.setAttribute('aria-expanded', 'true');
        localStorage.setItem('csc-a11y-collapsed', 'false');
      }
    }

    if (collapseBtn) {
      collapseBtn.addEventListener('click', () => setCollapsedState(true));
    }
    if (expandBtn) {
      expandBtn.addEventListener('click', () => setCollapsedState(false));
    }

    // First-time load check: if user has never explicitly collapsed it, load EXPANDED!
    const isExplicitlyCollapsed = localStorage.getItem('csc-a11y-collapsed') === 'true';
    setCollapsedState(isExplicitlyCollapsed);

    // Theme toggle
    const themeBtn = document.getElementById('theme-toggle-btn');
    const themeIcon = document.getElementById('theme-icon');
    const themeLabel = document.getElementById('theme-label');

    function updateThemeUI(theme) {
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
        if (themeIcon) themeIcon.textContent = '☀️';
        if (themeLabel) themeLabel.textContent = 'Light';
      } else {
        document.documentElement.classList.remove('light');
        document.documentElement.classList.add('dark');
        if (themeIcon) themeIcon.textContent = '🌙';
        if (themeLabel) themeLabel.textContent = 'Dark';
      }
    }

    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.contains('dark') || !document.documentElement.classList.contains('light');
        const nextTheme = isDark ? 'light' : 'dark';
        localStorage.setItem('csc-theme', nextTheme);
        updateThemeUI(nextTheme);
      });
    }

    // Font toggle
    const fontBtn = document.getElementById('toggle-font-btn');
    const fontLabel = document.getElementById('font-toggle-label');

    function updateFontUI(isDyslexic) {
      if (isDyslexic) {
        document.documentElement.classList.add('font-dyslexic');
        if (fontBtn) fontBtn.setAttribute('aria-pressed', 'true');
        if (fontLabel) fontLabel.textContent = 'Dyslexia Font: On';
      } else {
        document.documentElement.classList.remove('font-dyslexic');
        if (fontBtn) fontBtn.setAttribute('aria-pressed', 'false');
        if (fontLabel) fontLabel.textContent = 'Dyslexia Font: Off';
      }
    }

    if (fontBtn) {
      fontBtn.addEventListener('click', () => {
        const isDyslexic = document.documentElement.classList.contains('font-dyslexic');
        const nextState = !isDyslexic;
        localStorage.setItem('csc-font-dyslexic', nextState ? 'true' : 'false');
        updateFontUI(nextState);
      });
    }

    // Text size
    const sizeBtns = document.querySelectorAll('.size-btn');
    function applyTextSize(size) {
      document.documentElement.classList.remove('text-scale-normal', 'text-scale-lg', 'text-scale-xl');
      document.documentElement.classList.add('text-scale-' + size);
      localStorage.setItem('csc-text-size', size);
      sizeBtns.forEach(btn => {
        if (btn.getAttribute('data-size') === size) {
          btn.classList.add('bg-[#895294]', 'text-white', 'border-transparent');
          btn.classList.remove('bg-white', 'dark:bg-[#2a2948]', 'text-slate-800');
        } else {
          btn.classList.remove('bg-[#895294]', 'text-white', 'border-transparent');
          btn.classList.add('bg-white', 'dark:bg-[#2a2948]', 'text-slate-800');
        }
      });
    }

    sizeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const size = btn.getAttribute('data-size') || 'normal';
        applyTextSize(size);
      });
    });

    // High contrast
    const contrastBtn = document.getElementById('toggle-contrast-btn');
    if (contrastBtn) {
      contrastBtn.addEventListener('click', () => {
        const isHigh = document.documentElement.classList.toggle('high-contrast');
        localStorage.setItem('csc-high-contrast', isHigh ? 'true' : 'false');
        contrastBtn.setAttribute('aria-pressed', isHigh ? 'true' : 'false');
      });
    }

    // Init from localStorage
    const savedTheme = localStorage.getItem('csc-theme') || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    updateThemeUI(savedTheme);

    const savedFont = localStorage.getItem('csc-font-dyslexic') === 'true';
    updateFontUI(savedFont);

    const savedSize = localStorage.getItem('csc-text-size') || 'normal';
    applyTextSize(savedSize);

    const savedContrast = localStorage.getItem('csc-high-contrast') === 'true';
    if (savedContrast) {
      document.documentElement.classList.add('high-contrast');
      if (contrastBtn) contrastBtn.setAttribute('aria-pressed', 'true');
    }
  })();
</script>
