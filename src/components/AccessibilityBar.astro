---
import { Accessibility, Type, Contrast, Sun, Moon, X } from 'lucide-astro';
---

<!-- Accessible Display & Preferences Modal Dialog -->
<div 
  id="a11y-modal-backdrop" 
  class="fixed inset-0 z-[100] bg-black/60 backdrop-blur-sm hidden opacity-0 transition-opacity duration-200 flex flex-col justify-end sm:justify-center items-center p-0 sm:p-4"
  aria-hidden="true"
>
  <div 
    id="a11y-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="a11y-dialog-title"
    aria-describedby="a11y-dialog-desc"
    class="w-full sm:max-w-md bg-white dark:bg-[#21203a] border-t sm:border border-slate-200 dark:border-[#3e3c66] rounded-t-3xl sm:rounded-2xl shadow-2xl p-5 sm:p-6 pb-8 sm:pb-6 max-h-[85dvh] sm:max-h-[90vh] overflow-y-auto transform translate-y-full sm:translate-y-0 sm:scale-95 transition-all duration-200 focus:outline-none"
    tabindex="-1"
  >
    <!-- Mobile Sheet Handle Indicator -->
    <div class="sm:hidden w-10 h-1 bg-slate-300 dark:bg-[#3e3c66] rounded-full mx-auto mb-3 shrink-0" aria-hidden="true"></div>
    <!-- Dialog Header -->
    <div class="flex items-center justify-between pb-4 border-b border-slate-200 dark:border-[#3e3c66]">
      <div class="flex items-center gap-2.5 text-slate-900 dark:text-white">
        <div class="w-8 h-8 rounded-lg bg-[#895294]/15 dark:bg-[#6fb7e6]/20 text-[#895294] dark:text-[#6fb7e6] flex items-center justify-center">
          <Accessibility class="w-5 h-5" aria-hidden="true" />
        </div>
        <div>
          <h2 id="a11y-dialog-title" class="text-base font-heading font-bold uppercase tracking-wide">Display & Accessibility</h2>
          <p id="a11y-dialog-desc" class="text-xs text-slate-500 dark:text-[#bdaccf]">Customise your reading and visual preferences</p>
        </div>
      </div>
      <button
        id="a11y-close-btn"
        type="button"
        class="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-[#2a2948] transition-colors focus:outline-none focus:ring-2 focus:ring-[#6fb7e6]"
        aria-label="Close display settings"
      >
        <X class="w-5 h-5" aria-hidden="true" />
      </button>
    </div>

    <!-- Controls List -->
    <div class="py-4 space-y-4">
      <!-- Theme Switcher -->
      <div class="flex items-center justify-between">
        <div>
          <label class="text-sm font-semibold text-slate-800 dark:text-slate-200 block">Color Theme</label>
          <span class="text-xs text-slate-500 dark:text-[#bdaccf]">Switch between light and dark modes</span>
        </div>
        <button 
          id="theme-toggle-btn" 
          type="button" 
          class="btn-tactile px-3 py-1.5 rounded-lg border border-slate-300 dark:border-[#56548c] bg-slate-50 dark:bg-[#2a2948] hover:bg-slate-100 dark:hover:bg-[#382b5c] text-slate-800 dark:text-white text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-[#6fb7e6] flex items-center gap-1.5"
          aria-label="Toggle dark and light theme"
        >
          <Sun id="theme-icon-light" class="w-4 h-4 hidden text-amber-500" aria-hidden="true" />
          <Moon id="theme-icon-dark" class="w-4 h-4 text-[#6fb7e6]" aria-hidden="true" />
          <span id="theme-label">Dark</span>
        </button>
      </div>

      <!-- Dyslexia Font Toggle -->
      <div class="flex items-center justify-between">
        <div>
          <label class="text-sm font-semibold text-slate-800 dark:text-slate-200 block">Dyslexia-Friendly Font</label>
          <span class="text-xs text-slate-500 dark:text-[#bdaccf]">Atkinson Hyperlegible by Braille Institute</span>
        </div>
        <button 
          id="toggle-font-btn" 
          type="button" 
          class="btn-tactile px-3 py-1.5 rounded-lg border border-slate-300 dark:border-[#56548c] bg-slate-50 dark:bg-[#2a2948] hover:bg-slate-100 dark:hover:bg-[#382b5c] text-slate-800 dark:text-white text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-[#6fb7e6] flex items-center gap-1.5"
          aria-pressed="false"
        >
          <Type class="w-4 h-4 text-[#895294] dark:text-[#6fb7e6]" aria-hidden="true" />
          <span id="font-toggle-label">Off</span>
        </button>
      </div>

      <!-- Text Sizing -->
      <div class="flex items-center justify-between">
        <div>
          <label class="text-sm font-semibold text-slate-800 dark:text-slate-200 block">Text Sizing</label>
          <span class="text-xs text-slate-500 dark:text-[#bdaccf]">Scale base font size across the site</span>
        </div>
        <div class="flex items-center gap-1 border border-slate-300 dark:border-[#56548c] rounded-lg bg-slate-50 dark:bg-[#2a2948] p-1" role="group" aria-label="Text Size Controls">
          <button 
            type="button" 
            data-size="normal"
            class="size-btn px-2.5 py-1 rounded text-xs font-semibold focus:outline-none focus:ring-1 focus:ring-[#6fb7e6]"
            aria-label="Standard text size (100%)"
          >
            100%
          </button>
          <button 
            type="button" 
            data-size="lg"
            class="size-btn px-2.5 py-1 rounded text-xs font-bold focus:outline-none focus:ring-1 focus:ring-[#6fb7e6]"
            aria-label="Large text size (112%)"
          >
            112%
          </button>
          <button 
            type="button" 
            data-size="xl"
            class="size-btn px-2.5 py-1 rounded text-xs font-extrabold focus:outline-none focus:ring-1 focus:ring-[#6fb7e6]"
            aria-label="Extra large text size (125%)"
          >
            125%
          </button>
        </div>
      </div>

      <!-- High Contrast Mode -->
      <div class="flex items-center justify-between">
        <div>
          <label class="text-sm font-semibold text-slate-800 dark:text-slate-200 block">High Contrast Mode</label>
          <span class="text-xs text-slate-500 dark:text-[#bdaccf]">Maximises text-to-background contrast</span>
        </div>
        <button 
          id="toggle-contrast-btn" 
          type="button" 
          class="btn-tactile px-3 py-1.5 rounded-lg border border-slate-300 dark:border-[#56548c] bg-slate-50 dark:bg-[#2a2948] hover:bg-slate-100 dark:hover:bg-[#382b5c] text-slate-800 dark:text-white text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-[#6fb7e6] flex items-center gap-1.5"
          aria-pressed="false"
        >
          <Contrast class="w-4 h-4 text-[#895294] dark:text-[#6fb7e6]" aria-hidden="true" />
          <span id="contrast-toggle-label">Off</span>
        </button>
      </div>
    </div>

    <!-- Dialog Footer -->
    <div class="pt-4 border-t border-slate-200 dark:border-[#3e3c66] flex items-center justify-between text-xs text-slate-500 dark:text-[#bdaccf]">
      <span>Saved to this browser automatically</span>
      <button 
        id="a11y-done-btn"
        type="button"
        class="px-4 py-1.5 rounded-lg bg-[#895294] hover:bg-[#9d5fa8] text-white font-bold transition-colors focus:outline-none focus:ring-2 focus:ring-[#6fb7e6]"
      >
        Done
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const backdrop = document.getElementById('a11y-modal-backdrop');
    const dialog = document.getElementById('a11y-dialog');
    const closeBtn = document.getElementById('a11y-close-btn');
    const doneBtn = document.getElementById('a11y-done-btn');
    let lastActiveElement = null;

    function openModal() {
      if (!backdrop || !dialog) return;
      lastActiveElement = document.activeElement;
      backdrop.classList.remove('hidden');
      backdrop.setAttribute('aria-hidden', 'false');
      requestAnimationFrame(() => {
        backdrop.classList.remove('opacity-0');
        dialog.classList.remove('translate-y-full', 'sm:scale-95');
        dialog.classList.add('translate-y-0', 'sm:scale-100');
      });
      dialog.focus();
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!backdrop || !dialog) return;
      backdrop.classList.add('opacity-0');
      dialog.classList.remove('translate-y-0', 'sm:scale-100');
      dialog.classList.add('translate-y-full', 'sm:scale-95');
      setTimeout(() => {
        backdrop.classList.add('hidden');
        backdrop.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        if (lastActiveElement && typeof lastActiveElement.focus === 'function') {
          lastActiveElement.focus();
        }
      }, 200);
    }

    // Listen for custom open event
    window.addEventListener('toggle-a11y-bar', () => {
      const isHidden = backdrop ? backdrop.classList.contains('hidden') : true;
      if (isHidden) {
        openModal();
      } else {
        closeModal();
      }
    });

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (doneBtn) doneBtn.addEventListener('click', closeModal);

    // Backdrop click dismisses
    if (backdrop) {
      backdrop.addEventListener('click', (e) => {
        if (e.target === backdrop) closeModal();
      });
    }

    // Escape key closes modal
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && backdrop && !backdrop.classList.contains('hidden')) {
        closeModal();
      }
    });

    // Theme toggle
    const themeBtn = document.getElementById('theme-toggle-btn');
    const iconLight = document.getElementById('theme-icon-light');
    const iconDark = document.getElementById('theme-icon-dark');
    const themeLabel = document.getElementById('theme-label');

    function updateThemeUI(theme) {
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
        if (iconLight) iconLight.classList.remove('hidden');
        if (iconDark) iconDark.classList.add('hidden');
        if (themeLabel) themeLabel.textContent = 'Light';
      } else {
        document.documentElement.classList.remove('light');
        document.documentElement.classList.add('dark');
        if (iconLight) iconLight.classList.add('hidden');
        if (iconDark) iconDark.classList.remove('hidden');
        if (themeLabel) themeLabel.textContent = 'Dark';
      }
    }

    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.contains('dark') || !document.documentElement.classList.contains('light');
        const nextTheme = isDark ? 'light' : 'dark';
        localStorage.setItem('csc-theme', nextTheme);
        updateThemeUI(nextTheme);
      });
    }

    // Dyslexia Font toggle
    const fontBtn = document.getElementById('toggle-font-btn');
    const fontLabel = document.getElementById('font-toggle-label');

    function updateFontUI(isDyslexic) {
      if (isDyslexic) {
        document.documentElement.classList.add('font-dyslexic');
        if (fontBtn) {
          fontBtn.setAttribute('aria-pressed', 'true');
          fontBtn.classList.add('bg-[#895294]', 'text-white', 'border-[#895294]');
          fontBtn.classList.remove('bg-slate-50', 'dark:bg-[#2a2948]', 'text-slate-800', 'dark:text-white');
        }
        if (fontLabel) fontLabel.textContent = 'On';
      } else {
        document.documentElement.classList.remove('font-dyslexic');
        if (fontBtn) {
          fontBtn.setAttribute('aria-pressed', 'false');
          fontBtn.classList.remove('bg-[#895294]', 'text-white', 'border-[#895294]');
          fontBtn.classList.add('bg-slate-50', 'dark:bg-[#2a2948]', 'text-slate-800', 'dark:text-white');
        }
        if (fontLabel) fontLabel.textContent = 'Off';
      }
    }

    if (fontBtn) {
      fontBtn.addEventListener('click', () => {
        const isDyslexic = document.documentElement.classList.contains('font-dyslexic');
        const nextState = !isDyslexic;
        localStorage.setItem('csc-font-dyslexic', nextState ? 'true' : 'false');
        updateFontUI(nextState);
      });
    }

    // Text size
    const sizeBtns = document.querySelectorAll('.size-btn');
    function applyTextSize(size) {
      document.documentElement.classList.remove('text-scale-normal', 'text-scale-lg', 'text-scale-xl');
      document.documentElement.classList.add('text-scale-' + size);
      localStorage.setItem('csc-text-size', size);
      sizeBtns.forEach(btn => {
        if (btn.getAttribute('data-size') === size) {
          btn.classList.add('bg-[#895294]', 'text-white');
          btn.classList.remove('text-slate-700', 'dark:text-slate-300');
        } else {
          btn.classList.remove('bg-[#895294]', 'text-white');
          btn.classList.add('text-slate-700', 'dark:text-slate-300');
        }
      });
    }

    sizeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const size = btn.getAttribute('data-size') || 'normal';
        applyTextSize(size);
      });
    });

    // High contrast
    const contrastBtn = document.getElementById('toggle-contrast-btn');
    const contrastLabel = document.getElementById('contrast-toggle-label');

    function updateContrastUI(isHigh) {
      if (isHigh) {
        document.documentElement.classList.add('high-contrast');
        if (contrastBtn) {
          contrastBtn.setAttribute('aria-pressed', 'true');
          contrastBtn.classList.add('bg-[#895294]', 'text-white', 'border-[#895294]');
          contrastBtn.classList.remove('bg-slate-50', 'dark:bg-[#2a2948]', 'text-slate-800', 'dark:text-white');
        }
        if (contrastLabel) contrastLabel.textContent = 'On';
      } else {
        document.documentElement.classList.remove('high-contrast');
        if (contrastBtn) {
          contrastBtn.setAttribute('aria-pressed', 'false');
          contrastBtn.classList.remove('bg-[#895294]', 'text-white', 'border-[#895294]');
          contrastBtn.classList.add('bg-slate-50', 'dark:bg-[#2a2948]', 'text-slate-800', 'dark:text-white');
        }
        if (contrastLabel) contrastLabel.textContent = 'Off';
      }
    }

    if (contrastBtn) {
      contrastBtn.addEventListener('click', () => {
        const isHigh = document.documentElement.classList.contains('high-contrast');
        const nextState = !isHigh;
        localStorage.setItem('csc-high-contrast', nextState ? 'true' : 'false');
        updateContrastUI(nextState);
      });
    }

    // Init from localStorage
    const savedTheme = localStorage.getItem('csc-theme') || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    updateThemeUI(savedTheme);

    const savedFont = localStorage.getItem('csc-font-dyslexic') === 'true';
    updateFontUI(savedFont);

    const savedSize = localStorage.getItem('csc-text-size') || 'normal';
    applyTextSize(savedSize);

    const savedContrast = localStorage.getItem('csc-high-contrast') === 'true';
    updateContrastUI(savedContrast);
  })();
</script>
