---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-100 dark:bg-[#1b1a30] text-slate-600 dark:text-[#bdaccf] border-t border-slate-200 dark:border-[#3e3c66] mt-20 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Col 1: About & Mission with Brand Logo -->
      <div class="md:col-span-2 space-y-4">
        <a href={`${base}/`} class="inline-block" aria-label="Cyber Scotland Connect Home">
          <img 
            src={`${base}/branding/logo-white-horizontal.png`} 
            alt="Cyber Scotland Connect" 
            class="h-9 w-auto hidden dark:block" 
            width="230"
            height="36"
          />
          <img 
            src={`${base}/branding/logo-fullcolor-horizontal.png`} 
            alt="Cyber Scotland Connect" 
            class="h-9 w-auto block dark:hidden" 
            width="230"
            height="36"
          />
        </a>
        <p class="text-sm text-slate-600 dark:text-[#bdaccf] max-w-md leading-relaxed">
          An inclusive, grassroots community connecting cyber security practitioners, students, researchers, career switchers, and enthusiasts across Scotland. High-signal, zero-sales.
        </p>
        <div class="flex flex-wrap items-center gap-4 pt-1 text-sm font-semibold">
          <a
            href="https://www.meetup.com/cyberscotconnect/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#895294] dark:text-[#6fb7e6] hover:underline transition-colors flex items-center gap-1"
          >
            <span>Meetup</span> ↗
          </a>
          <a
            href="https://www.linkedin.com/company/cyber-scotland-connect/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#895294] dark:text-[#6fb7e6] hover:underline transition-colors flex items-center gap-1"
          >
            <span>LinkedIn</span> ↗
          </a>
          <a
            href="https://github.com/cyber-scotland-connect/csc-website"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#895294] dark:text-[#6fb7e6] hover:underline transition-colors flex items-center gap-1"
          >
            <span>GitHub</span> ↗
          </a>
          <a
            href="https://discord.gg/cyberscotlandconnect"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#895294] dark:text-[#6fb7e6] hover:underline transition-colors flex items-center gap-1"
          >
            <span>Discord</span> ↗
          </a>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div class="space-y-3">
        <h2 class="text-slate-900 dark:text-white font-heading font-bold text-sm tracking-wider uppercase">Explore</h2>
        <ul class="space-y-2 text-sm">
          <li><a href={`${base}/`} class="hover:text-slate-900 dark:hover:text-white transition-colors">Home / About</a></li>
          <li><a href={`${base}/events`} class="hover:text-slate-900 dark:hover:text-white transition-colors">Events & Meetups</a></li>
          <li><a href={`${base}/leaders`} class="hover:text-slate-900 dark:hover:text-white transition-colors">Leadership & Mods</a></li>
          <li><a href={`${base}/partners`} class="hover:text-slate-900 dark:hover:text-white transition-colors">Partners & Sponsors</a></li>
          <li><a href={`${base}/brand`} class="hover:text-slate-900 dark:hover:text-white transition-colors">Brand & Media Kit</a></li>
        </ul>
      </div>

      <!-- Col 3: Community & Governance -->
      <div class="space-y-3">
        <h2 class="text-slate-900 dark:text-white font-heading font-bold text-sm tracking-wider uppercase">Governance & Trust</h2>
        <ul class="space-y-2 text-sm">
          <li><a href={`${base}/code-of-conduct`} class="hover:text-slate-900 dark:hover:text-white transition-colors">Code of Conduct</a></li>
          <li><a href={`${base}/security`} class="hover:text-slate-900 dark:hover:text-white transition-colors">Security Disclosure</a></li>
          <li>
            <a
              href="https://buymeacoffee.com/cyberscotlandconnect"
              target="_blank"
              rel="noopener noreferrer"
              class="text-amber-600 dark:text-amber-400 hover:underline transition-colors font-semibold flex items-center gap-1"
            >
              <span>Pay It Forward (Coffee)</span> ↗
            </a>
          </li>
          <li>
            <a
              href="https://github.com/cyber-scotland-connect/csc-website/blob/main/CONTRIBUTING.md"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-slate-900 dark:hover:text-white transition-colors"
            >
              How to Contribute ↗
            </a>
          </li>
          <li>
            <a
              href="https://github.com/cyber-scotland-connect/csc-website/blob/main/AGENT.md"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-slate-900 dark:hover:text-white transition-colors text-[#895294] dark:text-[#6fb7e6] font-semibold"
            >
              AI Agents (AGENT.md) ↗
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-slate-200 dark:border-[#3e3c66] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-[#8c89b0]">
      <p>© {currentYear} Cyber Scotland Connect. Licensed under MIT. Proudly Scottish & Grassroots.</p>
      <div class="flex items-center gap-3">
        <span>Edinburgh • Glasgow • Dundee • Virtual</span>
      </div>
    </div>
  </div>
</footer>
