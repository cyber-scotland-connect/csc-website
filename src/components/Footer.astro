---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#1b1a30] text-[#bdaccf] border-t border-[#3e3c66] mt-20 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Col 1: About & Mission -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded bg-gradient-to-br from-[#895294] to-[#56548c] flex items-center justify-center text-white font-bold text-sm">
            CSC
          </div>
          <span class="font-heading font-bold text-white text-lg tracking-wide uppercase">
            Cyber Scotland Connect
          </span>
        </div>
        <p class="text-sm text-[#bdaccf] max-w-md leading-relaxed">
          An inclusive, grassroots community connecting cyber security practitioners, students, researchers, career switchers, and enthusiasts across Scotland. High-signal, zero-sales.
        </p>
        <div class="flex items-center gap-4 pt-2">
          <a
            href="https://www.meetup.com/cyberscotconnect/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#6fb7e6] hover:text-white transition-colors text-sm flex items-center gap-1 focus:ring-2 focus:ring-[#6fb7e6] rounded p-1"
          >
            <span>Meetup</span> ↗
          </a>
          <a
            href="https://www.linkedin.com/company/cyber-scotland-connect/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#6fb7e6] hover:text-white transition-colors text-sm flex items-center gap-1 focus:ring-2 focus:ring-[#6fb7e6] rounded p-1"
          >
            <span>LinkedIn</span> ↗
          </a>
          <a
            href="https://github.com/cyber-scotland-connect/csc-website"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#6fb7e6] hover:text-white transition-colors text-sm flex items-center gap-1 focus:ring-2 focus:ring-[#6fb7e6] rounded p-1"
          >
            <span>GitHub</span> ↗
          </a>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div class="space-y-3">
        <h2 class="text-white font-heading font-bold text-sm tracking-wider uppercase">Explore</h2>
        <ul class="space-y-2 text-sm">
          <li><a href={`${base}/`} class="hover:text-white transition-colors">Home / About</a></li>
          <li><a href={`${base}/events`} class="hover:text-white transition-colors">Events & Meetups</a></li>
          <li><a href={`${base}/leaders`} class="hover:text-white transition-colors">Leadership & Mods</a></li>
          <li><a href={`${base}/partners`} class="hover:text-white transition-colors">Partners & Sponsors</a></li>
        </ul>
      </div>

      <!-- Col 3: Community & Governance -->
      <div class="space-y-3">
        <h2 class="text-white font-heading font-bold text-sm tracking-wider uppercase">Governance & Trust</h2>
        <ul class="space-y-2 text-sm">
          <li><a href={`${base}/code-of-conduct`} class="hover:text-white transition-colors">Code of Conduct</a></li>
          <li><a href={`${base}/security`} class="hover:text-white transition-colors">Security Disclosure</a></li>
          <li>
            <a
              href="https://github.com/cyber-scotland-connect/csc-website/blob/main/CONTRIBUTING.md"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors"
            >
              How to Contribute ↗
            </a>
          </li>
          <li>
            <a
              href="https://github.com/cyber-scotland-connect/csc-website/blob/main/AGENT.md"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors text-[#6fb7e6]"
            >
              AI Agents (AGENT.md) ↗
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-[#3e3c66] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#8c89b0]">
      <p>© {currentYear} Cyber Scotland Connect. Licensed under MIT. Proudly Scottish & Grassroots.</p>
      <div class="flex items-center gap-3">
        <span>Edinburgh • Glasgow • Dundee • Virtual</span>
      </div>
    </div>
  </div>
</footer>
