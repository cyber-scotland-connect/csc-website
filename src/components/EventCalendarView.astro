---
import type { CollectionEntry } from 'astro:content';
import { ChevronLeft, ChevronRight, MapPin, Clock } from 'lucide-astro';

interface Props {
  events: CollectionEntry<'events'>[];
}

const { events } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Serialize event data for client-side calendar navigation
const calendarEvents = events.map((event) => {
  const dateObj = new Date(event.data.date);
  const year = dateObj.getFullYear();
  const month = String(dateObj.getMonth() + 1).padStart(2, '0');
  const day = String(dateObj.getDate()).padStart(2, '0');
  const dateStr = `${year}-${month}-${day}`;

  const isPartner = Boolean(
    event.data.isPartnerEvent || event.data.partnerName
  );

  return {
    id: event.id,
    title: event.data.title,
    date: dateStr,
    time: event.data.time || '',
    city: event.data.city,
    location: event.data.location,
    isPartner,
    partnerName: event.data.partnerName || null,
    slug: event.id,
    url: `${base}/events/${event.id}`,
  };
});
---

<div id="events-calendar-container" class="hidden mb-16 space-y-6">
  <!-- Calendar Card -->
  <div class="bg-white dark:bg-[#21203a] border border-slate-200 dark:border-[#3e3c66] rounded-2xl shadow-sm p-4 sm:p-6 transition-colors">
    <!-- Calendar Controls Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-slate-200 dark:border-[#3e3c66]">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#895294] dark:text-[#6fb7e6]">
            Interactive Schedule
          </span>
          <span
            class="text-xs px-2 py-0.5 rounded-full bg-slate-100 dark:bg-[#2a2948] text-slate-600 dark:text-[#bdaccf] font-mono"
            id="cal-filtered-count"
          >
            Loading...
          </span>
        </div>
        <h2
          id="calendar-current-month"
          class="text-2xl sm:text-3xl font-heading font-bold text-slate-900 dark:text-white uppercase tracking-tight mt-1"
        >
          Calendar
        </h2>
      </div>

      <div class="flex items-center gap-2 self-stretch sm:self-auto justify-between sm:justify-end">
        <button
          type="button"
          id="cal-prev-btn"
          class="btn-tactile p-2 rounded-xl border border-slate-200 dark:border-[#56548c] bg-white dark:bg-[#2a2948] hover:bg-slate-50 dark:hover:bg-[#382b5c] text-slate-700 dark:text-white transition-colors"
          aria-label="Previous month"
        >
          <ChevronLeft class="w-5 h-5" aria-hidden="true" />
        </button>

        <button
          type="button"
          id="cal-today-btn"
          class="btn-tactile px-3.5 py-2 text-xs font-bold uppercase tracking-wider rounded-xl border border-slate-200 dark:border-[#56548c] bg-white dark:bg-[#2a2948] hover:bg-slate-50 dark:hover:bg-[#382b5c] text-slate-700 dark:text-white transition-colors"
        >
          Today
        </button>

        <button
          type="button"
          id="cal-next-btn"
          class="btn-tactile p-2 rounded-xl border border-slate-200 dark:border-[#56548c] bg-white dark:bg-[#2a2948] hover:bg-slate-50 dark:hover:bg-[#382b5c] text-slate-700 dark:text-white transition-colors"
          aria-label="Next month"
        >
          <ChevronRight class="w-5 h-5" aria-hidden="true" />
        </button>
      </div>
    </div>

    <!-- Calendar Legend -->
    <div class="flex flex-wrap items-center justify-between gap-y-2 gap-x-6 py-3.5 text-xs text-slate-600 dark:text-[#bdaccf] border-b border-slate-100 dark:border-[#2a2948]">
      <div class="flex flex-wrap items-center gap-4">
        <span class="font-bold text-slate-900 dark:text-white uppercase font-mono text-[11px]">
          Legend:
        </span>
        <div class="flex items-center gap-1.5">
          <span class="w-3 h-3 rounded bg-[#895294] border border-[#9d5fa8]/50 inline-block"></span>
          <span>CSC Gatherings</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-3 h-3 rounded bg-emerald-700 border border-emerald-500/40 inline-block"></span>
          <span>Partner &amp; Ecosystem</span>
        </div>
      </div>

      <!-- City color dots -->
      <div class="flex flex-wrap items-center gap-3 text-[11px]">
        <div class="flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-[#6fb7e6]"></span>
          <span>Edinburgh</span>
        </div>
        <div class="flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-[#c084fc]"></span>
          <span>Glasgow</span>
        </div>
        <div class="flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-[#f472b6]"></span>
          <span>Dundee</span>
        </div>
        <div class="flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-[#fbbf24]"></span>
          <span>Aberdeen</span>
        </div>
        <div class="flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-[#38bdf8]"></span>
          <span>Virtual</span>
        </div>
      </div>
    </div>

    <!-- Calendar 7-Day Matrix -->
    <div class="mt-4 overflow-hidden rounded-xl border border-slate-200 dark:border-[#3e3c66]">
      <!-- Day Headers (Mon-Sun) -->
      <div class="grid grid-cols-7 bg-slate-50 dark:bg-[#1b1a30] border-b border-slate-200 dark:border-[#3e3c66] text-center font-mono text-xs font-bold text-slate-600 dark:text-[#bdaccf] uppercase py-2.5">
        <span class="hidden sm:inline">Mon</span>
        <span class="sm:hidden">M</span>
        <span class="hidden sm:inline">Tue</span>
        <span class="sm:hidden">T</span>
        <span class="hidden sm:inline">Wed</span>
        <span class="sm:hidden">W</span>
        <span class="hidden sm:inline">Thu</span>
        <span class="sm:hidden">T</span>
        <span class="hidden sm:inline">Fri</span>
        <span class="sm:hidden">F</span>
        <span class="hidden sm:inline">Sat</span>
        <span class="sm:hidden">S</span>
        <span class="hidden sm:inline">Sun</span>
        <span class="sm:hidden">S</span>
      </div>

      <!-- Days Grid Container -->
      <div
        id="calendar-grid"
        class="grid grid-cols-7 bg-slate-100 dark:bg-[#1b1a30] gap-[1px]"
      >
        <!-- Rendered by client script -->
      </div>
    </div>

    <!-- Selected Day Detail Panel (mobile / click trigger) -->
    <div
      id="calendar-day-details"
      class="hidden mt-6 p-5 rounded-xl bg-slate-50 dark:bg-[#1b1a30] border border-slate-200 dark:border-[#3e3c66]"
    >
      <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-200 dark:border-[#3e3c66]">
        <h3
          id="cal-day-details-title"
          class="text-sm font-mono font-bold uppercase tracking-wider text-slate-900 dark:text-white"
        >
          Events for Selected Day
        </h3>
        <button
          type="button"
          id="close-cal-day-details"
          class="text-xs text-slate-400 hover:text-slate-700 dark:hover:text-white font-semibold"
        >
          Dismiss &times;
        </button>
      </div>
      <div id="cal-day-details-list" class="space-y-3">
        <!-- Rendered dynamically -->
      </div>
    </div>
  </div>
</div>

<!-- Floating Popover Tooltip for Desktop Hover -->
<div
  id="cal-event-popover"
  class="fixed hidden z-50 pointer-events-none w-72 p-3.5 rounded-xl bg-slate-900/95 dark:bg-[#151426]/95 backdrop-blur-md border border-slate-700 dark:border-[#56548c] shadow-2xl text-white text-xs transition-opacity duration-150"
  role="tooltip"
  aria-hidden="true"
>
  <div class="flex items-center gap-1.5 mb-1.5">
    <span
      id="popover-badge"
      class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase"
    ></span>
    <span
      id="popover-city"
      class="px-2 py-0.5 rounded-full bg-slate-800 text-slate-300 text-[10px] font-mono"
    ></span>
  </div>
  <h4
    id="popover-title"
    class="font-bold text-sm leading-snug mb-2 text-white"
  ></h4>
  <div class="space-y-1 text-slate-300 text-[11px]">
    <div class="flex items-center gap-1.5">
      <Clock class="w-3.5 h-3.5 text-[#6fb7e6] shrink-0" />
      <span id="popover-time"></span>
    </div>
    <div class="flex items-center gap-1.5">
      <MapPin class="w-3.5 h-3.5 text-pink-400 shrink-0" />
      <span id="popover-location" class="truncate"></span>
    </div>
  </div>
  <div class="mt-2.5 pt-2 border-t border-slate-800 text-[10px] text-[#6fb7e6] font-semibold flex items-center justify-between">
    <span>Click to open event details</span>
    <span>&rarr;</span>
  </div>
</div>

<!-- Raw data script -->
<script
  is:inline
  id="calendar-raw-data"
  type="application/json"
  set:html={JSON.stringify(calendarEvents).replace(/</g, '\\u003c')}
/>
<script is:inline>
  (function () {
    const rawDataEl = document.getElementById('calendar-raw-data');
    if (!rawDataEl) return;

    let allCalendarEvents = [];
    try {
      allCalendarEvents = JSON.parse(rawDataEl.textContent || '[]');
    } catch (e) {
      console.error('Failed to parse calendar events data', e);
      return;
    }

    const cityColors = {
      edinburgh: '#6fb7e6',
      glasgow: '#c084fc',
      dundee: '#f472b6',
      aberdeen: '#fbbf24',
      virtual: '#38bdf8',
      'scotland-wide': '#a5b4fc',
    };

    // Determine starting month: default to current date, or the earliest upcoming event
    const today = new Date();
    let currentYear = today.getFullYear();
    let currentMonth = today.getMonth(); // 0-indexed

    // Calendar UI elements
    const gridEl = document.getElementById('calendar-grid');
    const monthTitleEl = document.getElementById('calendar-current-month');
    const prevBtn = document.getElementById('cal-prev-btn');
    const nextBtn = document.getElementById('cal-next-btn');
    const todayBtn = document.getElementById('cal-today-btn');
    const countBadgeEl = document.getElementById('cal-filtered-count');

    // Popover elements
    const popover = document.getElementById('cal-event-popover');
    const popoverTitle = document.getElementById('popover-title');
    const popoverBadge = document.getElementById('popover-badge');
    const popoverCity = document.getElementById('popover-city');
    const popoverTime = document.getElementById('popover-time');
    const popoverLocation = document.getElementById('popover-location');

    // Day details elements
    const dayDetailsPanel = document.getElementById('calendar-day-details');
    const dayDetailsTitle = document.getElementById('cal-day-details-title');
    const dayDetailsList = document.getElementById('cal-day-details-list');
    const closeDayDetails = document.getElementById('close-cal-day-details');

    if (closeDayDetails && dayDetailsPanel) {
      closeDayDetails.addEventListener('click', () => {
        dayDetailsPanel.classList.add('hidden');
      });
    }

    // Active filters (will be updated via page filter synchronization)
    window.calActiveCategory = 'all';
    window.calActiveCity = 'all';

    function getFilteredEvents() {
      const nowMidnight = new Date().setHours(0, 0, 0, 0);

      return allCalendarEvents.filter((event) => {
        const eventTime = new Date(event.date).getTime();
        const isUpcoming = eventTime >= nowMidnight;

        // Category filter
        let matchCategory = true;
        if (window.calActiveCategory === 'upcoming') matchCategory = isUpcoming;
        else if (window.calActiveCategory === 'past')
          matchCategory = !isUpcoming;
        else if (window.calActiveCategory === 'csc')
          matchCategory = !event.isPartner;
        else if (window.calActiveCategory === 'partner')
          matchCategory = event.isPartner;

        // City filter
        let matchCity = true;
        if (window.calActiveCity !== 'all') {
          matchCity =
            event.city.toLowerCase() === window.calActiveCity.toLowerCase();
        }

        return matchCategory && matchCity;
      });
    }

    function renderCalendar() {
      if (!gridEl || !monthTitleEl) return;

      const dateObj = new Date(currentYear, currentMonth, 1);
      const monthName = dateObj.toLocaleDateString('en-GB', {
        month: 'long',
        year: 'numeric',
      });
      monthTitleEl.textContent = monthName;

      const filteredEvents = getFilteredEvents();
      if (countBadgeEl) {
        countBadgeEl.textContent = `${filteredEvents.length} events match filters`;
      }

      // Calculate days in month & starting weekday (0=Sun, 1=Mon, ..., 6=Sat)
      // We want Monday as index 0: (day + 6) % 7
      const firstDayWeekday = (dateObj.getDay() + 6) % 7;
      const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
      const daysInPrevMonth = new Date(currentYear, currentMonth, 0).getDate();

      gridEl.innerHTML = '';

      const totalCells = Math.ceil((firstDayWeekday + daysInMonth) / 7) * 7;
      const todayDateStr = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;

      for (let i = 0; i < totalCells; i++) {
        const cell = document.createElement('div');
        cell.className =
          'min-h-[105px] sm:min-h-[120px] p-1.5 sm:p-2 bg-white dark:bg-[#21203a] flex flex-col justify-between transition-colors relative group';

        let cellDayNum;
        let cellDateStr;
        let isCurrentMonth = true;

        if (i < firstDayWeekday) {
          // Previous month days
          cellDayNum = daysInPrevMonth - (firstDayWeekday - 1 - i);
          const prevMonth = currentMonth === 0 ? 12 : currentMonth;
          const prevYear = currentMonth === 0 ? currentYear - 1 : currentYear;
          cellDateStr = `${prevYear}-${String(prevMonth).padStart(2, '0')}-${String(cellDayNum).padStart(2, '0')}`;
          isCurrentMonth = false;
          cell.classList.add(
            'opacity-40',
            'bg-slate-50/50',
            'dark:bg-[#1b1a30]/50'
          );
        } else if (i >= firstDayWeekday + daysInMonth) {
          // Next month days
          cellDayNum = i - (firstDayWeekday + daysInMonth) + 1;
          const nextMonth = currentMonth === 11 ? 1 : currentMonth + 2;
          const nextYear = currentMonth === 11 ? currentYear + 1 : currentYear;
          cellDateStr = `${nextYear}-${String(nextMonth).padStart(2, '0')}-${String(cellDayNum).padStart(2, '0')}`;
          isCurrentMonth = false;
          cell.classList.add(
            'opacity-40',
            'bg-slate-50/50',
            'dark:bg-[#1b1a30]/50'
          );
        } else {
          // Current month
          cellDayNum = i - firstDayWeekday + 1;
          cellDateStr = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}-${String(cellDayNum).padStart(2, '0')}`;
        }

        const isToday = cellDateStr === todayDateStr;

        // Day Number Header
        const headerDiv = document.createElement('div');
        headerDiv.className = 'flex items-center justify-between mb-1';

        const daySpan = document.createElement('span');
        daySpan.className =
          'text-xs font-mono font-bold leading-none inline-flex items-center justify-center';
        daySpan.textContent = cellDayNum;

        if (isToday) {
          daySpan.className +=
            ' w-6 h-6 rounded-full bg-[#895294] dark:bg-[#6fb7e6] text-white dark:text-slate-900 shadow-sm';
        } else if (!isCurrentMonth) {
          daySpan.className += ' text-slate-400 dark:text-slate-600';
        } else {
          daySpan.className += ' text-slate-700 dark:text-[#bdaccf]';
        }

        headerDiv.appendChild(daySpan);

        // Events on this date
        const dayEvents = filteredEvents.filter((e) => e.date === cellDateStr);

        if (dayEvents.length > 0) {
          const countPill = document.createElement('span');
          countPill.className =
            'text-[10px] font-mono font-bold text-slate-400 dark:text-slate-500 sm:hidden';
          countPill.textContent = `${dayEvents.length} •`;
          headerDiv.appendChild(countPill);
        }

        cell.appendChild(headerDiv);

        // Event Pills Container
        const pillsContainer = document.createElement('div');
        pillsContainer.className = 'space-y-1 flex-1 overflow-hidden';

        const MAX_PILLS = 2;
        dayEvents.slice(0, MAX_PILLS).forEach((evt) => {
          const pill = document.createElement('a');
          pill.href = evt.url;
          pill.className =
            'block truncate px-1.5 py-1 rounded text-[11px] font-medium transition-all shadow-sm flex items-center gap-1.5 cursor-pointer';

          const cityColor = cityColors[evt.city.toLowerCase()] || '#6fb7e6';

          if (evt.isPartner) {
            pill.className +=
              ' bg-emerald-700/90 hover:bg-emerald-600 text-emerald-50 border border-emerald-500/30';
          } else {
            pill.className +=
              ' bg-[#895294]/90 hover:bg-[#9d5fa8] text-white border border-[#9d5fa8]/30';
          }

          const dotSpan = document.createElement('span');
          dotSpan.className = 'w-1.5 h-1.5 rounded-full shrink-0';
          dotSpan.style.backgroundColor = cityColor;

          const titleSpan = document.createElement('span');
          titleSpan.className = 'truncate flex-1';
          titleSpan.textContent = evt.title;

          pill.appendChild(dotSpan);
          pill.appendChild(titleSpan);

          // Popover events
          pill.addEventListener('mouseenter', (e) => showPopover(e, evt));
          pill.addEventListener('mouseleave', hidePopover);
          pill.addEventListener('focus', (e) => showPopover(e, evt));
          pill.addEventListener('blur', hidePopover);

          pillsContainer.appendChild(pill);
        });

        if (dayEvents.length > MAX_PILLS) {
          const moreBtn = document.createElement('button');
          moreBtn.type = 'button';
          moreBtn.className =
            'text-[10px] font-mono font-bold text-[#895294] dark:text-[#6fb7e6] hover:underline block pt-0.5';
          moreBtn.textContent = `+${dayEvents.length - MAX_PILLS} more`;
          moreBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            showDayDetails(cellDateStr, dayEvents);
          });
          pillsContainer.appendChild(moreBtn);
        }

        cell.appendChild(pillsContainer);

        // Click or keyboard activation on cell to open details on mobile or if events present
        if (dayEvents.length > 0) {
          cell.classList.add('cursor-pointer', 'focus:outline-none', 'focus:ring-2', 'focus:ring-[#6fb7e6]', 'focus:z-10');
          cell.tabIndex = 0;
          cell.setAttribute('role', 'button');
          cell.setAttribute(
            'aria-label',
            `View ${dayEvents.length} ${dayEvents.length === 1 ? 'event' : 'events'} on ${cellDateStr}`
          );
          cell.addEventListener('click', () => {
            showDayDetails(cellDateStr, dayEvents);
          });
          cell.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              if (e.target === cell) {
                e.preventDefault();
                showDayDetails(cellDateStr, dayEvents);
              }
            }
          });
        }

        gridEl.appendChild(cell);
      }
    }

    function showPopover(e, evt) {
      if (!popover || window.innerWidth < 768) return;

      popoverTitle.textContent = evt.title;
      popoverTime.textContent = evt.time
        ? `${evt.date} @ ${evt.time}`
        : evt.date;
      popoverLocation.textContent = evt.location || evt.city;
      popoverCity.textContent = evt.city;

      if (evt.isPartner) {
        popoverBadge.textContent = evt.partnerName
          ? `Partner: ${evt.partnerName}`
          : 'Partner Event';
        popoverBadge.className =
          'px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-emerald-900 text-emerald-200 border border-emerald-500/40';
      } else {
        popoverBadge.textContent = 'CSC Gathering';
        popoverBadge.className =
          'px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-[#895294] text-white border border-[#9d5fa8]/50';
      }

      popover.classList.remove('hidden');

      const rect = e.currentTarget.getBoundingClientRect();
      const popoverWidth = 288; // w-72 = 18rem = 288px
      let left = rect.left + window.scrollX;
      let top = rect.bottom + window.scrollY + 8;

      if (left + popoverWidth > window.innerWidth - 16) {
        left = window.innerWidth - popoverWidth - 16;
      }

      popover.style.left = `${Math.max(16, left)}px`;
      popover.style.top = `${top}px`;
    }

    function hidePopover() {
      if (popover) {
        popover.classList.add('hidden');
      }
    }

    function showDayDetails(dateStr, events) {
      if (!dayDetailsPanel || !dayDetailsTitle || !dayDetailsList) return;

      const formatted = new Date(dateStr).toLocaleDateString('en-GB', {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        year: 'numeric',
      });

      dayDetailsTitle.textContent = `Events for ${formatted} (${events.length})`;
      dayDetailsList.innerHTML = '';

      events.forEach((evt) => {
        const item = document.createElement('div');
        item.className =
          'p-3 rounded-lg bg-white dark:bg-[#2a2948] border border-slate-200 dark:border-[#3e3c66] flex flex-col sm:flex-row sm:items-center justify-between gap-3';

        const cityColor = cityColors[evt.city.toLowerCase()] || '#6fb7e6';

        const leftDiv = document.createElement('div');
        leftDiv.className = 'space-y-1';

        const metaRow = document.createElement('div');
        metaRow.className = 'flex items-center gap-2';

        const cityDot = document.createElement('span');
        cityDot.className = 'w-2 h-2 rounded-full';
        cityDot.style.backgroundColor = cityColor;

        const cityLabel = document.createElement('span');
        cityLabel.className =
          'text-xs font-mono font-bold uppercase text-slate-500 dark:text-[#bdaccf]';
        cityLabel.textContent = evt.city;

        const typeBadge = document.createElement('span');
        if (evt.isPartner) {
          typeBadge.className =
            'text-[10px] px-2 py-0.5 rounded bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 font-bold uppercase';
          typeBadge.textContent = 'Partner';
        } else {
          typeBadge.className =
            'text-[10px] px-2 py-0.5 rounded bg-purple-100 dark:bg-[#382b5c] text-[#895294] dark:text-[#6fb7e6] font-bold uppercase';
          typeBadge.textContent = 'CSC';
        }

        metaRow.appendChild(cityDot);
        metaRow.appendChild(cityLabel);
        metaRow.appendChild(typeBadge);

        const titleEl = document.createElement('h4');
        titleEl.className = 'font-bold text-sm text-slate-900 dark:text-white';
        titleEl.textContent = evt.title;

        const subRow = document.createElement('p');
        subRow.className =
          'text-xs text-slate-600 dark:text-[#bdaccf] flex items-center gap-3';

        const timeSpan = document.createElement('span');
        timeSpan.textContent = `⏰ ${evt.time || 'TBA'}`;

        const locSpan = document.createElement('span');
        locSpan.textContent = `📍 ${evt.location}`;

        subRow.appendChild(timeSpan);
        subRow.appendChild(locSpan);

        leftDiv.appendChild(metaRow);
        leftDiv.appendChild(titleEl);
        leftDiv.appendChild(subRow);

        const actionLink = document.createElement('a');
        actionLink.href = evt.url;
        actionLink.className =
          'self-start sm:self-auto btn-tactile px-3.5 py-1.5 rounded-lg bg-[#895294] hover:bg-[#9d5fa8] text-white text-xs font-bold transition-all shadow-sm flex items-center gap-1.5 shrink-0';

        const actionText = document.createElement('span');
        actionText.textContent = 'View Details';

        const actionArrow = document.createElement('span');
        actionArrow.textContent = '→';
        actionArrow.setAttribute('aria-hidden', 'true');

        actionLink.appendChild(actionText);
        actionLink.appendChild(actionArrow);

        item.appendChild(leftDiv);
        item.appendChild(actionLink);
        dayDetailsList.appendChild(item);
      });

      dayDetailsPanel.classList.remove('hidden');
      dayDetailsPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    // Month Navigation listeners
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        currentMonth--;
        if (currentMonth < 0) {
          currentMonth = 11;
          currentYear--;
        }
        renderCalendar();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        currentMonth++;
        if (currentMonth > 11) {
          currentMonth = 0;
          currentYear++;
        }
        renderCalendar();
      });
    }

    if (todayBtn) {
      todayBtn.addEventListener('click', () => {
        currentYear = today.getFullYear();
        currentMonth = today.getMonth();
        renderCalendar();
      });
    }

    // Hook into global filter updates
    window.updateCalendarFilters = function (category, city) {
      window.calActiveCategory = category;
      window.calActiveCity = city;
      renderCalendar();
    };

    // Initial render
    renderCalendar();
  })();
</script>
