---
import BaseLayout from '../layouts/BaseLayout.astro';
import PartnerCard from '../components/PartnerCard.astro';
import { getCollection } from 'astro:content';

const allPartners = await getCollection('partners');
const activePartners = allPartners.filter(p => p.data.active).sort((a, b) => a.data.order - b.data.order);

const venuePartners = activePartners.filter(p => p.data.tier === 'Host Venue');
const ecosystemPartners = activePartners.filter(p => p.data.tier === 'Ecosystem Partner');
const academicPartners = activePartners.filter(p => p.data.tier === 'Academic Partner');
const sponsors = activePartners.filter(p => p.data.tier === 'Sponsor');
---

<BaseLayout 
  title="Partners & Sponsors" 
  description="Explore the venue hosts, ecosystem clusters, academic institutions, and sponsors supporting Cyber Scotland Connect."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="border-b border-slate-200 dark:border-[#3e3c66] pb-8 mb-12 transition-colors">
      <span class="text-xs font-semibold uppercase tracking-wider text-[#56548c] dark:text-[#6fb7e6] block mb-1">
        Community Supporters & Venues
      </span>
      <h1 class="text-3xl sm:text-5xl font-heading font-bold text-slate-900 dark:text-white uppercase tracking-tight transition-colors">
        Partners & Sponsors
      </h1>
      <p class="text-slate-600 dark:text-[#bdaccf] text-base mt-2 max-w-2xl transition-colors">
        Cyber Scotland Connect is entirely free for all attendees thanks to our venue hosts, academic collaborations, and ethical community sponsors.
      </p>
    </div>

    <!-- Host Venues -->
    <section class="mb-14">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-xl">🏢</span>
        <h2 class="text-2xl font-heading font-bold text-slate-900 dark:text-white uppercase tracking-wide transition-colors">
          Host Venues
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {venuePartners.map(partner => <PartnerCard partner={partner} />)}
      </div>
    </section>

    <!-- Ecosystem & Academic Clusters -->
    <section class="mb-14">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-xl">🌐</span>
        <h2 class="text-2xl font-heading font-bold text-slate-900 dark:text-white uppercase tracking-wide transition-colors">
          Ecosystem & Academic Partners
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[...ecosystemPartners, ...academicPartners].map(partner => <PartnerCard partner={partner} />)}
      </div>
    </section>

    <!-- Sponsors -->
    {sponsors.length > 0 && (
      <section class="mb-16">
        <div class="flex items-center gap-3 mb-6">
          <span class="text-xl">🤝</span>
          <h2 class="text-2xl font-heading font-bold text-slate-900 dark:text-white uppercase tracking-wide transition-colors">
            Sponsors & Supporters
          </h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {sponsors.map(partner => <PartnerCard partner={partner} />)}
        </div>
      </section>
    )}

    <!-- Individual Supporters: Pay It Forward -->
    <section class="mb-16 bg-gradient-to-r from-purple-50 via-white to-amber-50/50 dark:from-[#252342] dark:via-[#1e1d35] dark:to-[#2b2738] rounded-2xl border-2 border-[#895294]/30 dark:border-[#56548c]/60 p-8 sm:p-10 shadow-lg">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
        <div class="md:col-span-2 space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100 dark:bg-amber-950/60 border border-amber-300 dark:border-amber-700 text-xs font-bold text-amber-900 dark:text-amber-300">
            <span>☕ Pay It Forward</span>
            <span>•</span>
            <span>Community-Funded</span>
          </div>
          <h2 class="text-2xl font-heading font-bold text-slate-900 dark:text-white uppercase tracking-tight">
            Individual Supporters & Community Giving
          </h2>
          <p class="text-sm text-slate-600 dark:text-[#bdaccf] leading-relaxed">
            CSC is not just backed by organizations—it is powered by our attendees. Through our <strong>Buy Me a Coffee</strong> initiative, established practitioners support refreshments and keep our gatherings 100% free and accessible for students and job seekers.
          </p>
        </div>

        <div class="flex flex-col items-center justify-center text-center p-6 rounded-xl bg-white/80 dark:bg-[#21203a] border border-amber-200 dark:border-[#3e3c66]">
          <span class="text-3xl mb-2" aria-hidden="true">☕</span>
          <span class="text-sm font-bold text-slate-900 dark:text-white mb-1">Buy Me a Coffee</span>
          <p class="text-xs text-slate-500 dark:text-[#bdaccf] mb-4">One-off or monthly community support</p>
          <a
            href="https://buymeacoffee.com/cyberscotlandconnect"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-2.5 px-4 rounded-xl font-bold text-xs bg-[#FFDD00] hover:bg-[#ffea4d] text-slate-900 shadow transition-all flex items-center justify-center gap-1.5 focus:ring-2 focus:ring-[#895294]"
          >
            <span>Pay It Forward</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Hosting & Ethical Sponsorship Policy -->
    <div class="bg-slate-50 dark:bg-[#1b1a30] rounded-2xl border border-slate-200 dark:border-[#3e3c66] p-8 sm:p-10 text-slate-600 dark:text-[#bdaccf] space-y-6 transition-colors">
      <h2 class="text-2xl font-heading font-bold text-slate-900 dark:text-white uppercase">
        Our Ethical Sponsorship & Venue Policy
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-sm leading-relaxed">
        <div class="space-y-3">
          <h3 class="text-base font-bold text-[#56548c] dark:text-[#6fb7e6]">1. Zero Pay-to-Play Speaking</h3>
          <p>
            Speaking slots are never sold. Sponsorship funds pay directly for pizza, soft drinks, recording gear, and accessibility requirements. Presentation abstracts are selected purely on technical merit by our volunteer organizers.
          </p>
          <h3 class="text-base font-bold text-[#56548c] dark:text-[#6fb7e6]">2. Privacy & Attendee Data Protection</h3>
          <p>
            We never share, sell, or distribute attendee contact lists or attendee emails to sponsors. Our community trust is non-negotiable.
          </p>
        </div>

        <div class="space-y-3">
          <h3 class="text-base font-bold text-[#895294]">3. Venue Accessibility Baselines</h3>
          <p>
            Any venue wishing to host a CSC gathering must provide step-free access, working elevator access to presentation floors, accessible restrooms, and induction loop compatibility.
          </p>
          <div class="pt-2">
            <a
              href="mailto:hello@cyberscotlandconnect.com"
              class="inline-block px-5 py-2.5 rounded-lg bg-[#56548c] hover:bg-[#6764a8] text-white font-bold text-xs shadow transition-colors"
            >
              Enquire About Hosting or Sponsoring
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
