---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import { getCollection } from 'astro:content';

const allEvents = await getCollection('events');
const sortedEvents = allEvents.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const nowTime = new Date().setHours(0, 0, 0, 0);
const upcomingEvents = sortedEvents
  .filter(e => new Date(e.data.date).getTime() >= nowTime)
  .reverse();

const pastEvents = sortedEvents.filter(e => new Date(e.data.date).getTime() < nowTime);
const partnerEvents = sortedEvents.filter(e => e.data.isPartnerEvent);
---

<BaseLayout 
  title="Events & Meetups" 
  description="Explore upcoming and historical Cyber Scotland Connect meetups, workshops, and partner events across Edinburgh, Glasgow, Dundee, and virtual."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="border-b border-slate-200 dark:border-[#3e3c66] pb-8 mb-10 transition-colors">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-[#56548c] dark:text-[#6fb7e6] block mb-1">
            Scottish Community Calendar
          </span>
          <h1 class="text-3xl sm:text-5xl font-heading font-bold text-slate-900 dark:text-white uppercase tracking-tight transition-colors">
            Events & Gatherings
          </h1>
          <p class="text-slate-600 dark:text-[#bdaccf] text-base mt-2 max-w-2xl transition-colors">
            Discover upcoming regional meetups, virtual technical streams, and collaborative Scottish cyber partner events. Always free, always high-signal.
          </p>
        </div>

        <div class="flex items-center gap-3">
          <a
            href="https://www.meetup.com/cyberscotconnect/"
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded-lg bg-[#895294] hover:bg-[#9d5fa8] text-white font-bold text-sm shadow-md transition-all flex items-center gap-1.5"
          >
            <span>Join on Meetup</span> ↗
          </a>
        </div>
      </div>

      <!-- Filter Controls: Category & Regional Chapter -->
      <div class="space-y-3 mt-8">
        <div class="flex flex-wrap items-center gap-2" role="tablist" aria-label="Event category filters">
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mr-1 hidden sm:inline">Type:</span>
          <button
            type="button"
            data-filter-type="category"
            data-value="all"
            class="filter-cat-btn active px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-semibold bg-[#895294] text-white transition-colors"
            role="tab"
            aria-selected="true"
          >
            All Events ({sortedEvents.length})
          </button>
          <button
            type="button"
            data-filter-type="category"
            data-value="upcoming"
            class="filter-cat-btn px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-semibold bg-white dark:bg-[#2a2948] text-slate-700 dark:text-[#bdaccf] hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-[#3e3c66] transition-colors"
            role="tab"
            aria-selected="false"
          >
            Upcoming ({upcomingEvents.length})
          </button>
          <button
            type="button"
            data-filter-type="category"
            data-value="csc"
            class="filter-cat-btn px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-semibold bg-white dark:bg-[#2a2948] text-slate-700 dark:text-[#bdaccf] hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-[#3e3c66] transition-colors"
            role="tab"
            aria-selected="false"
          >
            CSC Gatherings ({sortedEvents.filter(e => !e.data.isPartnerEvent).length})
          </button>
          <button
            type="button"
            data-filter-type="category"
            data-value="partner"
            class="filter-cat-btn px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-semibold bg-white dark:bg-[#2a2948] text-slate-700 dark:text-[#bdaccf] hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-[#3e3c66] transition-colors"
            role="tab"
            aria-selected="false"
          >
            Partner Events ({partnerEvents.length})
          </button>
          <button
            type="button"
            data-filter-type="category"
            data-value="past"
            class="filter-cat-btn px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-semibold bg-white dark:bg-[#2a2948] text-slate-700 dark:text-[#bdaccf] hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-[#3e3c66] transition-colors"
            role="tab"
            aria-selected="false"
          >
            Archive ({pastEvents.length})
          </button>
        </div>

        <!-- Regional Chapter Chips -->
        <div class="flex flex-wrap items-center gap-1.5 pt-1" role="tablist" aria-label="Regional chapter filters">
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mr-1 hidden sm:inline">Chapter:</span>
          <button
            type="button"
            data-filter-type="city"
            data-value="all"
            class="filter-city-btn active px-2.5 py-1 rounded-md text-xs font-medium bg-[#56548c] text-white transition-colors"
            role="tab"
            aria-selected="true"
          >
            All Chapters
          </button>
          <button
            type="button"
            data-filter-type="city"
            data-value="edinburgh"
            class="filter-city-btn px-2.5 py-1 rounded-md text-xs font-medium bg-slate-100 dark:bg-[#1b1a30] text-slate-700 dark:text-[#bdaccf] hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-[#3e3c66] transition-colors flex items-center gap-1"
            role="tab"
            aria-selected="false"
          >
            <span>🏰</span> <span>Edinburgh</span>
          </button>
          <button
            type="button"
            data-filter-type="city"
            data-value="glasgow"
            class="filter-city-btn px-2.5 py-1 rounded-md text-xs font-medium bg-slate-100 dark:bg-[#1b1a30] text-slate-700 dark:text-[#bdaccf] hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-[#3e3c66] transition-colors flex items-center gap-1"
            role="tab"
            aria-selected="false"
          >
            <span>🚢</span> <span>Glasgow</span>
          </button>
          <button
            type="button"
            data-filter-type="city"
            data-value="dundee"
            class="filter-city-btn px-2.5 py-1 rounded-md text-xs font-medium bg-slate-100 dark:bg-[#1b1a30] text-slate-700 dark:text-[#bdaccf] hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-[#3e3c66] transition-colors flex items-center gap-1"
            role="tab"
            aria-selected="false"
          >
            <span>🎮</span> <span>Dundee</span>
          </button>
          <button
            type="button"
            data-filter-type="city"
            data-value="aberdeen"
            class="filter-city-btn px-2.5 py-1 rounded-md text-xs font-medium bg-slate-100 dark:bg-[#1b1a30] text-slate-700 dark:text-[#bdaccf] hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-[#3e3c66] transition-colors flex items-center gap-1"
            role="tab"
            aria-selected="false"
          >
            <span>⚡</span> <span>Aberdeen</span>
          </button>
          <button
            type="button"
            data-filter-type="city"
            data-value="virtual"
            class="filter-city-btn px-2.5 py-1 rounded-md text-xs font-medium bg-slate-100 dark:bg-[#1b1a30] text-slate-700 dark:text-[#bdaccf] hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-[#3e3c66] transition-colors flex items-center gap-1"
            role="tab"
            aria-selected="false"
          >
            <span>🌐</span> <span>Virtual</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Events Grid -->
    <div id="events-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {sortedEvents.map(event => {
        const isUp = new Date(event.data.date).getTime() >= nowTime;
        const isPartner = event.data.isPartnerEvent;
        return (
          <div 
            class="event-item"
            data-is-upcoming={isUp ? 'true' : 'false'}
            data-is-partner={isPartner ? 'true' : 'false'}
            data-city={event.data.city.toLowerCase()}
          >
            <EventCard event={event} />
          </div>
        );
      })}

      <!-- Empty state when filter has no matches -->
      <div id="no-events-msg" class="hidden col-span-full py-12 px-6 text-center bg-slate-50 dark:bg-[#1b1a30] rounded-2xl border border-dashed border-slate-300 dark:border-[#3e3c66]">
        <span class="text-3xl mb-2 block">📅</span>
        <h3 class="text-lg font-heading font-bold text-slate-900 dark:text-white uppercase mb-1">No Events Found</h3>
        <p class="text-sm text-slate-600 dark:text-[#bdaccf] max-w-md mx-auto">
          There are currently no events matching this filter. Check back soon or follow our <a href="https://www.meetup.com/cyberscotconnect/" target="_blank" rel="noopener noreferrer" class="text-[#895294] dark:text-[#6fb7e6] underline font-semibold">Meetup group</a> for announcements.
        </p>
      </div>
    </div>

    <!-- Call for Speakers / High-Signal Policy Box -->
    <div class="bg-slate-50 dark:bg-[#1b1a30] rounded-2xl border border-slate-200 dark:border-[#3e3c66] p-8 sm:p-10 text-slate-600 dark:text-[#bdaccf] transition-colors">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
        <div class="md:col-span-2 space-y-3">
          <span class="text-xs font-semibold uppercase tracking-wider text-[#56548c] dark:text-[#6fb7e6]">
            Call for Presentations (CFP)
          </span>
          <h2 class="text-2xl font-heading font-bold text-slate-900 dark:text-white uppercase">
            Want to speak at an upcoming gathering?
          </h2>
          <p class="text-sm leading-relaxed">
            We actively support first-time speakers, student researchers, and seasoned defenders. Every talk must respect our <strong>"High-Signal, Zero-Sales"</strong> charter: 60-second limit on company intros, zero product pitches, and 100% focus on actionable security engineering and hard lessons learned.
          </p>
        </div>

        <div class="flex flex-col gap-3">
          <a
            href="mailto:hello@cyberscotlandconnect.com"
            class="px-5 py-3 rounded-lg bg-[#56548c] hover:bg-[#6764a8] text-white font-bold text-sm text-center shadow transition-colors"
          >
            Submit a Talk Idea
          </a>
          <a
            href="https://github.com/cyber-scotland-connect/csc-website/blob/main/AGENT.md"
            class="px-5 py-3 rounded-lg bg-white dark:bg-[#2a2948] hover:bg-slate-100 dark:hover:bg-[#382b5c] border border-slate-200 dark:border-[#3e3c66] text-slate-800 dark:text-white text-xs text-center transition-colors shadow-sm"
          >
            Review Speaker Guidelines ↗
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const catBtns = document.querySelectorAll('.filter-cat-btn');
  const cityBtns = document.querySelectorAll('.filter-city-btn');
  const eventItems = document.querySelectorAll('.event-item');
  const noEventsMsg = document.getElementById('no-events-msg');

  let activeCategory = 'all';
  let activeCity = 'all';

  function applyCombinedFilters() {
    let visibleCount = 0;

    eventItems.forEach(item => {
      const isUp = item.getAttribute('data-is-upcoming') === 'true';
      const isPartner = item.getAttribute('data-is-partner') === 'true';
      const itemCity = item.getAttribute('data-city') || '';

      let matchCat = true;
      if (activeCategory === 'upcoming') matchCat = isUp;
      else if (activeCategory === 'past') matchCat = !isUp;
      else if (activeCategory === 'partner') matchCat = isPartner;
      else if (activeCategory === 'csc') matchCat = !isPartner;

      let matchCity = true;
      if (activeCity !== 'all') {
        matchCity = itemCity === activeCity;
      }

      const show = matchCat && matchCity;
      item.style.display = show ? 'block' : 'none';
      if (show) visibleCount++;
    });

    if (noEventsMsg) {
      if (visibleCount === 0) {
        noEventsMsg.classList.remove('hidden');
      } else {
        noEventsMsg.classList.add('hidden');
      }
    }
  }

  catBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      catBtns.forEach(b => {
        b.classList.remove('active', 'bg-[#895294]', 'text-white');
        b.classList.add('bg-white', 'dark:bg-[#2a2948]', 'text-slate-700', 'dark:text-[#bdaccf]');
        b.setAttribute('aria-selected', 'false');
      });

      btn.classList.add('active', 'bg-[#895294]', 'text-white');
      btn.classList.remove('bg-white', 'dark:bg-[#2a2948]', 'text-slate-700', 'dark:text-[#bdaccf]');
      btn.setAttribute('aria-selected', 'true');

      activeCategory = btn.getAttribute('data-value') || 'all';
      applyCombinedFilters();
    });
  });

  cityBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      cityBtns.forEach(b => {
        b.classList.remove('active', 'bg-[#56548c]', 'text-white');
        b.classList.add('bg-slate-100', 'dark:bg-[#1b1a30]', 'text-slate-700', 'dark:text-[#bdaccf]');
        b.setAttribute('aria-selected', 'false');
      });

      btn.classList.add('active', 'bg-[#56548c]', 'text-white');
      btn.classList.remove('bg-slate-100', 'dark:bg-[#1b1a30]', 'text-slate-700', 'dark:text-[#bdaccf]');
      btn.setAttribute('aria-selected', 'true');

      activeCity = btn.getAttribute('data-value') || 'all';
      applyCombinedFilters();
    });
  });
</script>
