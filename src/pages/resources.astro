---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { getCollection } from 'astro:content';

const allResources = await getCollection('resources');

const categories = [
  {
    name: 'Scottish & UK Ecosystem',
    icon: '🏴󠁧󠁢󠁳󠁣󠁴󠁿',
    description:
      'National coordination, public sector incident response, and professional career frameworks across Scotland and the UK.',
  },
  {
    name: 'Defensive & Detection Engineering',
    icon: '🛡️',
    description:
      'Open threat models, generic detection signatures, and continuous detection engineering standards.',
  },
  {
    name: 'Offensive & AppSec',
    icon: '⚔️',
    description:
      'Living standards, penetration testing methodologies, and community vulnerability research resources.',
  },
  {
    name: 'DFIR & Incident Response',
    icon: '🔍',
    description:
      'Real-world adversary campaign analyses, memory and filesystem forensic tooling, and open CTI platforms.',
  },
  {
    name: 'Cloud, DevSecOps & Supply Chain',
    icon: '☁️',
    description:
      'Vendor-agnostic control frameworks, container hardening guides, and software bill-of-materials (SBOM) platforms.',
  },
  {
    name: 'Interactive Labs & Tooling',
    icon: '💻',
    description:
      'Hands-on wargames, cryptanalysis challenges, protocol dissection, and open-source data manipulation utilities.',
  },
] as const;

// Sort resources by order ascending
const sortedResources = allResources.sort(
  (a, b) => a.data.order - b.data.order
);

const resourcesByCategory = categories.map((cat) => ({
  ...cat,
  resources: sortedResources.filter((r) => r.data.category === cat.name),
}));

const totalCount = sortedResources.length;
---

<BaseLayout
  title="Community Resources & Reading Room"
  description="Curated, community-driven cybersecurity projects, open standards, hands-on labs, and mental health support resources for the Scottish cyber community."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <header
      class="border-b border-slate-200 dark:border-[#3e3c66] pb-8 mb-12 transition-colors"
    >
      <span
        class="text-xs font-semibold uppercase tracking-wider text-[#56548c] dark:text-[#6fb7e6] block mb-1"
      >
        Knowledge & Community Care
      </span>
      <h1
        class="text-3xl sm:text-5xl font-heading font-bold text-slate-900 dark:text-white uppercase tracking-tight transition-colors"
      >
        Community Resources
      </h1>
      <p
        class="text-slate-600 dark:text-[#bdaccf] text-base mt-2 max-w-3xl leading-relaxed transition-colors"
      >
        A hand-curated directory of {totalCount} premier open-source tools, living
        standards, and community initiatives maintained by the Cyber Scotland Connect
        community.
      </p>

      <!-- Category Quick Jump Bar -->
      <nav
        aria-label="Resource Categories"
        class="mt-6 flex flex-wrap gap-2 pt-4"
      >
        {
          categories.map((cat) => (
            <a
              href={`#${cat.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
              class="inline-flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-[#21203a] text-slate-700 dark:text-[#bdaccf] hover:bg-[#895294] hover:text-white dark:hover:bg-[#56548c] dark:hover:text-white border border-slate-200 dark:border-[#3e3c66] transition-all"
            >
              <span>{cat.icon}</span>
              <span>{cat.name}</span>
            </a>
          ))
        }
      </nav>
    </header>

    <!-- Mental Health & Community Wellbeing Banner -->
    <section
      aria-labelledby="wellbeing-heading"
      class="mb-16 bg-gradient-to-br from-purple-50 to-indigo-50 dark:from-[#211f3d] dark:to-[#1b1a30] rounded-2xl border border-purple-200 dark:border-[#3e3c66] p-8 sm:p-10 shadow-sm transition-colors"
    >
      <div class="max-w-3xl mb-8">
        <span
          class="text-xs font-semibold uppercase tracking-wider text-[#895294] dark:text-[#6fb7e6] block mb-1"
        >
          💚 Community Wellbeing & Support
        </span>
        <h2
          id="wellbeing-heading"
          class="text-2xl font-heading font-bold text-slate-900 dark:text-white uppercase tracking-wide"
        >
          Mental Health in Infosec
        </h2>
        <p
          class="text-sm text-slate-600 dark:text-[#bdaccf] leading-relaxed mt-2"
        >
          Working in cybersecurity involves high-pressure environments, on-call
          rotations, and intense incident response cycles. Mental health
          challenges do not discriminate, and our community believes support
          should always be accessible, judgement-free, and stigma-free.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- SAMH -->
        <div
          class="bg-white dark:bg-[#2a2948] p-6 rounded-xl border border-slate-200 dark:border-[#3e3c66] shadow-sm flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xl" aria-hidden="true">🏴󠁧󠁢󠁳󠁣󠁴󠁿</span>
              <h3
                class="font-heading font-bold text-base text-slate-900 dark:text-white"
              >
                SAMH
              </h3>
            </div>
            <p
              class="text-xs text-slate-600 dark:text-[#bdaccf] leading-relaxed"
            >
              Scottish Association for Mental Health. Operating across Scottish
              communities to provide direct support, suicide prevention, and
              mental health services.
            </p>
          </div>
          <a
            href="https://www.samh.org.uk"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 text-xs font-bold text-[#895294] dark:text-[#6fb7e6] hover:underline flex items-center gap-1"
          >
            <span>Visit samh.org.uk</span> ↗
          </a>
        </div>

        <!-- Breathing Space & Nightline -->
        <div
          class="bg-white dark:bg-[#2a2948] p-6 rounded-xl border border-slate-200 dark:border-[#3e3c66] shadow-sm flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xl" aria-hidden="true">🌙</span>
              <h3
                class="font-heading font-bold text-base text-slate-900 dark:text-white"
              >
                Breathing Space & Nightline
              </h3>
            </div>
            <p
              class="text-xs text-slate-600 dark:text-[#bdaccf] leading-relaxed"
            >
              Free, confidential listening and mental health support across Scotland. Breathing Space (0800 83 85 87) operates across Scottish communities, alongside local student services like Edinburgh Nightline.
            </p>
          </div>
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <a
              href="https://breathingspace.scot/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-bold text-[#895294] dark:text-[#6fb7e6] hover:underline flex items-center gap-1"
            >
              <span>Breathing Space</span> ↗
            </a>
            <span class="text-xs text-slate-300 dark:text-slate-600">•</span>
            <a
              href="https://ednightline.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-bold text-[#895294] dark:text-[#6fb7e6] hover:underline flex items-center gap-1"
            >
              <span>Edinburgh Nightline</span> ↗
            </a>
          </div>
        </div>

        <!-- Community Chat -->
        <div
          class="bg-white dark:bg-[#2a2948] p-6 rounded-xl border border-slate-200 dark:border-[#3e3c66] shadow-sm flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xl" aria-hidden="true">💬</span>
              <h3
                class="font-heading font-bold text-base text-slate-900 dark:text-white"
              >
                #well-being Space
              </h3>
            </div>
            <p
              class="text-xs text-slate-600 dark:text-[#bdaccf] leading-relaxed"
            >
              Our community chat includes a dedicated space for peer
              conversations on work-life balance, imposter syndrome, and coping
              with on-call burnout.
            </p>
          </div>
          <a
            href="https://discord.gg/cyberscotlandconnect"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 text-xs font-bold text-[#895294] dark:text-[#6fb7e6] hover:underline flex items-center gap-1"
          >
            <span>Join Community Chat</span> ↗
          </a>
        </div>
      </div>
    </section>

    <!-- Reading Room / Community Resources Sections -->
    <main class="space-y-16">
      {
        resourcesByCategory.map((categoryGroup) => (
          <section
            id={categoryGroup.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}
            class="scroll-mt-12"
            aria-labelledby={`heading-${categoryGroup.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
          >
            <div class="border-b border-slate-200 dark:border-[#3e3c66] pb-4 mb-6">
              <div class="flex items-center gap-3">
                <span class="text-2xl" aria-hidden="true">
                  {categoryGroup.icon}
                </span>
                <h2
                  id={`heading-${categoryGroup.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
                  class="text-2xl font-heading font-bold text-slate-900 dark:text-white uppercase tracking-wide"
                >
                  {categoryGroup.name}
                </h2>
              </div>
              <p class="text-sm text-slate-600 dark:text-[#bdaccf] mt-1">
                {categoryGroup.description}
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {categoryGroup.resources.map((resource) => (
                <ResourceCard resource={resource} />
              ))}
            </div>
          </section>
        ))
      }

      <!-- Contribute a Resource Callout -->
      <section
        class="mt-20 bg-slate-50 dark:bg-[#21203a] rounded-2xl border border-slate-200 dark:border-[#3e3c66] p-8 text-center sm:text-left sm:flex sm:items-center sm:justify-between gap-6 transition-colors"
      >
        <div class="max-w-2xl">
          <div
            class="flex items-center justify-center sm:justify-start gap-2 mb-2"
          >
            <span class="text-xl" aria-hidden="true">💡</span>
            <h2
              class="text-xl font-heading font-bold text-slate-900 dark:text-white uppercase tracking-tight"
            >
              Know an exceptional open resource?
            </h2>
          </div>
          <p class="text-sm text-slate-600 dark:text-[#bdaccf] leading-relaxed">
            Our reading room is maintained directly by the community. We
            prioritise open-source tools, living standards, and non-commercial
            projects. Simply create a markdown file in our repository to submit
            a pull request.
          </p>
        </div>
        <div class="mt-6 sm:mt-0 flex-shrink-0">
          <a
            href="https://github.com/cyber-scotland-connect/csc-website/blob/main/.github/content-templates/resource.md"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-xs uppercase tracking-wider bg-[#895294] text-white hover:bg-[#6e3e78] dark:bg-[#6fb7e6] dark:text-slate-900 dark:hover:bg-[#5aa3cf] transition-colors shadow-sm"
          >
            <span>Suggest a Resource</span>
            <span>↗</span>
          </a>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
