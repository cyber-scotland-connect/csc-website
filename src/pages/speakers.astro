---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Retrieve all events
const allEvents = await getCollection('events');

interface SpeakerTalk {
  talkTitle: string;
  abstract?: string;
  eventSlug: string;
  eventTitle: string;
  eventDate: Date;
  city: string;
}

interface AggregatedSpeaker {
  name: string;
  role?: string;
  company?: string;
  leadershipRole?: string;
  talks: SpeakerTalk[];
  talkCount: number;
}

const leadershipRoles: Record<string, string> = {
  'harry mclaren': 'Co-Founder & Organiser',
  'stu hirst': 'Co-Founder & Organiser',
  'sophie lanc': 'Community Organiser',
  'gary hunter': 'Community Moderator',
  'magda de jager': 'Community Moderator',
  'dr. rich macfarlane': 'Community Moderator',
  'rich macfarlane': 'Community Moderator',
  'kevin gray': 'Community Moderator',
  'richard grey': 'Community Moderator',
  'james ramirez': 'Community Moderator',
};

const speakerMap = new Map<string, AggregatedSpeaker>();
const citiesSet = new Set<string>();

allEvents.forEach(event => {
  citiesSet.add(event.data.city);
  if (!event.data.speakers || event.data.speakers.length === 0) return;

  event.data.speakers.forEach(speaker => {
    const key = speaker.name.trim().toLowerCase();
    const existing = speakerMap.get(key);

    const talk: SpeakerTalk = {
      talkTitle: speaker.talkTitle,
      abstract: speaker.abstract,
      eventSlug: event.id,
      eventTitle: event.data.title,
      eventDate: new Date(event.data.date),
      city: event.data.city,
    };

    const leadershipRole = leadershipRoles[key];

    if (existing) {
      existing.talks.push(talk);
      existing.talkCount = existing.talks.length;
      if (speaker.role) existing.role = speaker.role;
      if (speaker.company) existing.company = speaker.company;
      if (leadershipRole && !existing.leadershipRole) existing.leadershipRole = leadershipRole;
    } else {
      speakerMap.set(key, {
        name: speaker.name.trim(),
        role: speaker.role,
        company: speaker.company,
        leadershipRole,
        talks: [talk],
        talkCount: 1,
      });
    }
  });
});

// Sort talks within each speaker chronologically (newest first)
speakerMap.forEach(speaker => {
  speaker.talks.sort((a, b) => b.eventDate.getTime() - a.eventDate.getTime());
});

// Sort speakers: most talks first, then alphabetically
const speakersList = Array.from(speakerMap.values()).sort((a, b) => {
  if (b.talkCount !== a.talkCount) {
    return b.talkCount - a.talkCount;
  }
  return a.name.localeCompare(b.name);
});

const totalTalks = speakersList.reduce((acc, s) => acc + s.talkCount, 0);
---

<BaseLayout 
  title="Speakers & Session Archive" 
  description="Discover the defenders, researchers, and technical leaders who have shared knowledge across Cyber Scotland Connect gatherings."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Page Header -->
    <div class="border-b border-slate-200 dark:border-[#3e3c66] pb-8 mb-10 transition-colors">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-[#56548c] dark:text-[#6fb7e6] block mb-1">
            Community Hall of Fame
          </span>
          <h1 class="text-3xl sm:text-5xl font-heading font-bold text-slate-900 dark:text-white uppercase tracking-tight transition-colors">
            Speakers & Contributors
          </h1>
          <p class="text-slate-600 dark:text-[#bdaccf] text-base mt-2 max-w-2xl transition-colors">
            A directory of the cyber defenders, engineers, and researchers who have delivered high-signal, zero-sales technical talks across Scotland.
          </p>
        </div>

        <a
          href={`${base}/faq#speaking`}
          class="px-5 py-2.5 rounded-lg bg-[#895294] hover:bg-[#9d5fa8] text-white font-bold text-sm shadow transition-all flex items-center gap-1.5"
        >
          <span>Submit a Talk Idea</span> ↗
        </a>
      </div>

      <!-- Quick Metrics Ribbon -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-8">
        <div class="bg-slate-50 dark:bg-[#1b1a30] p-4 rounded-xl border border-slate-200 dark:border-[#3e3c66]">
          <span class="text-2xl sm:text-3xl font-heading font-bold text-[#895294] dark:text-[#6fb7e6] block">
            {speakersList.length}
          </span>
          <span class="text-xs text-slate-500 dark:text-[#bdaccf] uppercase font-semibold">Featured Speakers</span>
        </div>
        <div class="bg-slate-50 dark:bg-[#1b1a30] p-4 rounded-xl border border-slate-200 dark:border-[#3e3c66]">
          <span class="text-2xl sm:text-3xl font-heading font-bold text-[#56548c] dark:text-[#bdaccf] block">
            {totalTalks}
          </span>
          <span class="text-xs text-slate-500 dark:text-[#bdaccf] uppercase font-semibold">Technical Talks</span>
        </div>
        <div class="bg-slate-50 dark:bg-[#1b1a30] p-4 rounded-xl border border-slate-200 dark:border-[#3e3c66] col-span-2 sm:col-span-1">
          <span class="text-2xl sm:text-3xl font-heading font-bold text-slate-800 dark:text-white block">
            {citiesSet.size}
          </span>
          <span class="text-xs text-slate-500 dark:text-[#bdaccf] uppercase font-semibold">Scottish Chapters</span>
        </div>
      </div>
    </div>

    <!-- Speakers Grid -->
    {speakersList.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
        {speakersList.map(speaker => (
          <div class="bg-white dark:bg-[#2a2948] rounded-2xl border border-slate-200 dark:border-[#3e3c66] p-6 shadow-sm hover:border-[#895294] transition-all flex flex-col justify-between">
            <div>
              <!-- Header Row: Speaker Name & Talk Count Badge -->
              <div class="flex items-start justify-between gap-3 mb-2">
                <div>
                  <div class="flex flex-wrap items-center gap-2">
                    <h2 class="text-xl font-heading font-bold text-slate-900 dark:text-white">
                      {speaker.name}
                    </h2>
                    {speaker.leadershipRole && (
                      <span 
                        class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-[#895294]/15 dark:bg-[#6fb7e6]/20 text-[#895294] dark:text-[#6fb7e6] border border-[#895294]/30 dark:border-[#6fb7e6]/40 flex items-center gap-1 shadow-sm"
                        title={`${speaker.name} is part of the CSC Leadership Team: ${speaker.leadershipRole}`}
                      >
                        <span aria-hidden="true">🛡️</span>
                        <span>{speaker.leadershipRole}</span>
                      </span>
                    )}
                  </div>
                  {(speaker.role || speaker.company) && (
                    <p class="text-xs text-slate-500 dark:text-[#bdaccf] mt-0.5">
                      {speaker.role}{speaker.role && speaker.company ? ' · ' : ''}{speaker.company}
                    </p>
                  )}
                </div>

                <!-- Talk Count Badge -->
                <span 
                  class="shrink-0 px-2.5 py-1 rounded-full text-xs font-bold bg-purple-100 dark:bg-[#382b5c] text-[#895294] dark:text-[#6fb7e6] border border-purple-200 dark:border-[#56548c] shadow-sm flex items-center gap-1"
                  title={`${speaker.name} has delivered ${speaker.talkCount} talk(s) for CSC`}
                >
                  <span aria-hidden="true">🎤</span>
                  <span>{speaker.talkCount} {speaker.talkCount === 1 ? 'Talk' : 'Talks'}</span>
                </span>
              </div>

              <!-- Talks List -->
              <div class="mt-4 pt-4 border-t border-slate-100 dark:border-[#3e3c66]/60 space-y-4">
                <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 block">
                  Session History:
                </span>
                {speaker.talks.map(talk => (
                  <div class="bg-slate-50 dark:bg-[#1b1a30] p-3.5 rounded-xl border border-slate-200/80 dark:border-[#3e3c66]/60 space-y-1.5">
                    <h3 class="text-sm font-bold text-[#56548c] dark:text-[#6fb7e6] leading-snug">
                      "{talk.talkTitle}"
                    </h3>
                    <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500 dark:text-[#bdaccf]">
                      <a 
                        href={`${base}/events/${talk.eventSlug}`}
                        class="font-semibold text-slate-700 dark:text-slate-300 hover:text-[#895294] dark:hover:text-[#6fb7e6] hover:underline flex items-center gap-1"
                      >
                        <span>{talk.eventTitle}</span> →
                      </a>
                      <span>•</span>
                      <span>{talk.city}</span>
                      <span>•</span>
                      <span>{talk.eventDate.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}</span>
                    </div>
                    {talk.abstract && (
                      <p class="text-xs text-slate-600 dark:text-[#bdaccf] leading-relaxed line-clamp-3 pt-1">
                        {talk.abstract}
                      </p>
                    )}
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="py-16 text-center bg-slate-50 dark:bg-[#1b1a30] rounded-2xl border border-slate-200 dark:border-[#3e3c66] mb-16">
        <span class="text-4xl mb-3 block">🎤</span>
        <h3 class="text-lg font-heading font-bold text-slate-900 dark:text-white uppercase mb-1">Speaker Archive Initialising</h3>
        <p class="text-sm text-slate-600 dark:text-[#bdaccf] max-w-md mx-auto">
          Our speaker profiles are populated automatically from our events calendar. Check back as new sessions are published!
        </p>
      </div>
    )}

    <!-- Speaker Call for Presentations (CFP) CTA Box -->
    <div class="bg-gradient-to-r from-purple-50 via-white to-sky-50 dark:from-[#252342] dark:via-[#1e1d35] dark:to-[#22273d] rounded-2xl border-2 border-[#895294]/30 dark:border-[#56548c]/60 p-8 sm:p-10 shadow-lg text-slate-700 dark:text-[#bdaccf]">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
        <div class="md:col-span-2 space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-100 dark:bg-[#382b5c] border border-purple-200 dark:border-[#56548c] text-xs font-bold text-[#895294] dark:text-[#6fb7e6]">
            <span>🎤 Call for Presentations</span>
            <span>•</span>
            <span>First-Timers Welcomed</span>
          </div>
          <h2 class="text-2xl font-heading font-bold text-slate-900 dark:text-white uppercase tracking-tight">
            Share Your Defense Lessons with Scotland
          </h2>
          <p class="text-sm leading-relaxed">
            Have you built an interesting detection pipeline, analyzed threat adversary tradecraft, or learned painful architectural lessons during an incident? We actively mentor and welcome first-time speakers, student researchers, and seasoned CISOs alike.
          </p>
        </div>

        <div class="flex flex-col gap-3">
          <a
            href={`${base}/faq#speaking`}
            class="px-5 py-3 rounded-xl bg-[#895294] hover:bg-[#9d5fa8] text-white font-bold text-sm text-center shadow-md hover:shadow-lg transition-all"
          >
            Review Speaker FAQ & Guidelines →
          </a>
          <a
            href="mailto:hello@cyberscotlandconnect.com"
            class="px-5 py-3 rounded-xl bg-white dark:bg-[#2a2948] hover:bg-slate-100 dark:hover:bg-[#382b5c] border border-slate-200 dark:border-[#3e3c66] text-slate-800 dark:text-white text-xs font-semibold text-center transition-colors shadow-sm"
          >
            Email Talk Proposal ✉️
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
