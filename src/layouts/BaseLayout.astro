---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AccessibilityBar from '../components/AccessibilityBar.astro';
import '@fontsource/roboto/300.css';
import '@fontsource/roboto/400.css';
import '@fontsource/roboto/400-italic.css';
import '@fontsource/roboto/500.css';
import '@fontsource/roboto/700.css';
import '@fontsource/roboto-condensed/400.css';
import '@fontsource/roboto-condensed/700.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '@fontsource/opendyslexic/400.css';
import '@fontsource/opendyslexic/400-italic.css';
import '@fontsource/opendyslexic/700.css';
import '@fontsource/opendyslexic/700-italic.css';
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/400-italic.css';
import '@fontsource/atkinson-hyperlegible/700.css';
import '@fontsource/atkinson-hyperlegible/700-italic.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  structuredData?: Record<string, any> | Record<string, any>[];
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const {
  title,
  description = "Cyber Scotland Connect (CSC) — Grassroots community connecting cyber security practitioners, students, and enthusiasts across Scotland.",
  ogImage = `${base}/branding/icon-linkedin.png`,
  structuredData,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://cyberscotlandconnect.com');
const fullTitle = `${title} | Cyber Scotland Connect`;
const resolvedOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, canonicalURL.origin).href;

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Cyber Scotland Connect",
  "alternateName": "CSC",
  "url": "https://cyberscotlandconnect.com",
  "logo": "https://cyberscotlandconnect.com/branding/logo-fullcolor-stacked.png",
  "description": description,
  "sameAs": [
    "https://www.meetup.com/cyberscotconnect/",
    "https://www.linkedin.com/company/cyber-scotland-connect/",
    "https://github.com/cyber-scotland-connect",
    "https://discord.gg/9SKzqdZNvS"
  ]
};
---

<!DOCTYPE html>
<html lang="en-GB" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#21203a" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Official Brand Favicons -->
    <link rel="icon" type="image/png" href={`${base}/branding/icon-fullcolor.png`} />
    <link rel="apple-touch-icon" href={`${base}/branding/icon-fullcolor.png`} />

    <!-- Security & Hygiene -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;"
    />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />

    <!-- Open Graph (LinkedIn, Discord, Messaging) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:site_name" content="Cyber Scotland Connect" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Calendar, RSS & LLM Feeds Autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Scottish Cyber Community Events RSS"
      href={`${base}/feeds/community.xml`}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Cyber Scotland Connect Gatherings RSS"
      href={`${base}/feeds/csc.xml`}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Scottish Cyber Partner Events RSS"
      href={`${base}/feeds/partner.xml`}
    />
    <link
      rel="alternate"
      type="text/calendar"
      title="Scottish Cyber Community Events iCal"
      href={`${base}/calendar/community.ics`}
    />
    <link
      rel="alternate"
      type="text/calendar"
      title="Cyber Scotland Connect Gatherings iCal"
      href={`${base}/calendar/csc.ics`}
    />
    <link
      rel="llms"
      type="text/plain"
      title="Cyber Scotland Connect LLM Context"
      href={`${base}/llms.txt`}
    />

    <!-- JSON-LD Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaData).replace(/</g, '\\u003c')} />
    {structuredData && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    )}

    <!-- Inline script to prevent FOUC for dark/light mode and accessibility prefs -->
    <script is:inline>
      (function() {
        try {
          const theme = localStorage.getItem('csc-theme') || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          if (theme === 'light') {
            document.documentElement.classList.remove('dark');
            document.documentElement.classList.add('light');
          } else {
            document.documentElement.classList.remove('light');
            document.documentElement.classList.add('dark');
          }

          if (localStorage.getItem('csc-font-dyslexic') === 'true') {
            document.documentElement.classList.add('font-dyslexic');
          }

          const size = localStorage.getItem('csc-text-size');
          if (size) {
            document.documentElement.classList.add('text-scale-' + size);
          }

          if (localStorage.getItem('csc-high-contrast') === 'true') {
            document.documentElement.classList.add('high-contrast');
          }
        } catch (e) {
          // Fallback gracefully if localStorage is disabled
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col antialiased selection:bg-[#895294] selection:text-white">
    <a href="#main-content" class="skip-to-content">Skip to main content</a>

    <Header />

    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <Footer />

    <AccessibilityBar />
  </body>
</html>
