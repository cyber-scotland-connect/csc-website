{
  "name": "csc-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check:links": "bun run scripts/check-links.ts",
    "discover": "bun run scripts/discover-events.ts --ai --write",
    "discover:dry": "bun run scripts/discover-events.ts --ai",
    "notify:discord:csc": "bun run scripts/notify-discord.ts --scope csc",
    "notify:discord:scotland": "bun run scripts/notify-discord.ts --scope scotland",
    "notify:discord:dry:csc": "bun run scripts/notify-discord.ts --scope csc --latest --dry-run",
    "notify:discord:dry:scotland": "bun run scripts/notify-discord.ts --scope scotland --latest --dry-run"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "lucide-astro": "^0.556.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1"
  }
}
